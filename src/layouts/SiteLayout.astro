---
// Layout unico del sito: riproduce la struttura delle pagine legacy
// (head SEO, header con selettore lingua, contenuto, footer, script).
// Il contenuto arriva come frammento HTML già pronto (prop `main`,
// tipicamente `<main>…</main>` più eventuali sezioni finali).
import i18n from '~/data/i18n.json';

export interface PageMeta {
  path: string;
  lang: string;
  title: string;
  description: string | null;
  canonical: string | null;
  robots: string | null;
  author: string | null;
  og: [string, string][];
  jsonld: string[];
  hreflangs: [string, string][];
  extraHead: string[];
  assetPrefix: string;
  iconLinks: string[];
  brandHref: string;
  brandImgSrc: string;
  optionsHtml: string;
  bodyScripts: string[];
  ui?: { nav: string; footerGrid: string };
}

// Versione del foglio di stile: da alzare quando cambia public/styles.css.
// Tutte le pagine puntano allo stesso indirizzo, così i browser tengono una
// sola copia in cache e non possono mostrare due versioni diverse dell'header.
const CSS_VERSION = '20261010c';

const { meta, main } = Astro.props as { meta: PageMeta; main: string };

const ui = meta.ui ?? i18n.ui[meta.lang];
// Il portoghese è quello del Brasile: la chiave interna è «pt», la lingua dichiarata «pt-BR».
const htmlLang = meta.lang === 'pt' ? 'pt-BR' : meta.lang;
const current = i18n.languages[meta.lang] ?? { name: meta.lang, flag: '', summaryAria: 'Choose language' };
const stylesheetHref = `${meta.assetPrefix}styles.css?v=${CSS_VERSION}`;

// Bottone WhatsApp fisso in basso a destra, su tutte le pagine (Martin, 2026-10-10):
// chi scrive prenota la lezione di prova con Martin o Licia, poi passa a Preply.
// Il messaggio precompilato è in italiano come quello dei bottoni grandi della home;
// in portoghese è tradotto, come nella home /pt/.
const whatsappText =
  meta.lang === 'pt'
    ? 'Olá, gostaria de marcar uma aula experimental de italiano com Martin ou Licia.'
    : 'Ciao, vorrei prenotare una lezione di prova di italiano con Martin o Licia.';
const whatsappHref = `https://wa.me/393280555034?text=${encodeURIComponent(whatsappText)}`;
const whatsappLabel = (current as { whatsappLabel?: string }).whatsappLabel ?? 'WhatsApp';

// public/script.js costruisce il bottone del menu (l'hamburger) che sotto i
// 900 pixel è l'unico modo di aprire la navigazione: senza di lui il menu
// sparisce e basta. Molte pagine non lo dichiarano in `bodyScripts`, perché
// l'elenco arriva dal sito storico; qui lo aggiungiamo dove manca, così il
// menu funziona su tutte le pagine. Chi ce l'ha già lo tiene com'è: il
// riferimento non va duplicato e non va cambiato, per non far scattare
// l'audit dei link e la rete di sicurezza della parità.
const hasSiteScript = meta.bodyScripts.some((script) => /script\.js/.test(script));
const siteScriptHref = `${meta.assetPrefix}script.js`;

// Dati strutturati BreadcrumbList ricavati dalle briciole di pane già in pagina
// («Home / Grammatica / A1 / Articoli»): Google mostra il percorso nei risultati.
// I segmenti senza link (il livello «A1») restano fuori, l'ultimo è la pagina.
function breadcrumbJsonLd(html: string, canonical: string | null): string | null {
  if (!canonical) return null;
  const block = html.match(/<(p|nav|div)[^>]*class="breadcrumbs"[^>]*>([\s\S]*?)<\/\1>/);
  if (!block) return null;
  const decode = (s: string) =>
    s
      .replace(/<[^>]+>/g, '')
      .replace(/&nbsp;/g, ' ')
      .replace(/&amp;/g, '&')
      .replace(/&#39;|&apos;/g, "'")
      .replace(/&quot;/g, '"')
      .replace(/\s+/g, ' ')
      .trim();
  const segments = block[2].split(/\s\/\s/);
  const items: { name: string; item: string }[] = [];
  segments.forEach((segment, index) => {
    const link = segment.match(/<a[^>]*href="([^"]*)"[^>]*>([\s\S]*?)<\/a>/);
    const name = decode(link ? link[2] : segment);
    if (!name) return;
    if (index === segments.length - 1) items.push({ name, item: canonical });
    else if (link) items.push({ name, item: new URL(link[1], canonical).href });
  });
  if (items.length < 2) return null;
  return JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map(({ name, item }, index) => ({ '@type': 'ListItem', position: index + 1, name, item })),
  });
}
const breadcrumbs = breadcrumbJsonLd(main, meta.canonical);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    {meta.hreflangs.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{meta.title}</title>
    {meta.description !== null && <meta name="description" content={meta.description} />}
    {meta.canonical !== null && <link rel="canonical" href={meta.canonical} />}
    {meta.robots !== null && <meta name="robots" content={meta.robots} />}
    {meta.author !== null && <meta name="author" content={meta.author} />}
    {
      meta.og.map(([key, value]) =>
        key.startsWith('og:') ? <meta property={key} content={value} /> : <meta name={key} content={value} />
      )
    }
    {meta.jsonld.map((json) => <script type="application/ld+json" set:html={json} />)}
    {breadcrumbs && <script type="application/ld+json" set:html={breadcrumbs} />}
    {/* styles.css va PRIMA dei CSS di pagina: quelli di pagina devono poter sovrascrivere le regole generali. */}
    <link rel="stylesheet" href={stylesheetHref} />
    {meta.extraHead.map((html) => <Fragment set:html={html} />)}
    {meta.iconLinks.map((html) => <Fragment set:html={html} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={meta.brandHref}>
          <img class="brand-avatar" src={meta.brandImgSrc} alt="Martin" width="48" height="48" decoding="async" />
          <span>Italiano con Martin</span>
        </a>
        <details class="language-switcher">
          <summary aria-label={current.summaryAria}>
            <span class="language-flag" aria-hidden="true" set:text={current.flag} />
            <span class="language-current" set:text={current.name} />
            <span class="language-chevron" aria-hidden="true" set:text={'⌄'} />
          </summary>
          <div class="language-options" set:html={meta.optionsHtml} />
        </details>
        <nav set:html={ui.nav} />
      </div>
    </header>
    <Fragment set:html={main} />
    <footer>
      <div class="container footer-grid" set:html={ui.footerGrid} />
    </footer>
    <a class="whatsapp-float" href={whatsappHref} target="_blank" rel="noopener" aria-label={whatsappLabel} title={whatsappLabel}>
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
    </a>
    {meta.bodyScripts.map((script) => <Fragment set:html={script} />)}
    {!hasSiteScript && <script is:inline src={siteScriptHref} />}
  </body>
</html>
