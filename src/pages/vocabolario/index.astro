const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: vocabolario/index.html -->\n<html lang=\"it\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/vocabolario/\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/vocabulary/\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/vocabulario/\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/vocabulaire/\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/slovni-zasoba/\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/slownictwo/\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/kelime-bilgisi/\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/wortschatz/\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/goi/\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/vocabolario/\">\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <title>Vocabolario italiano illustrato | Italiano con Martin</title>\n    <meta name=\"description\" content=\"Impara il vocabolario italiano per ambienti con immagini, frasi d’esempio, pronuncia ed esercizi.\">\n    <link rel=\"canonical\" href=\"https://italianoconmartin.com/vocabolario/\">\n    <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n    <meta name=\"author\" content=\"Martin Modena\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n    <meta property=\"og:title\" content=\"Vocabolario italiano illustrato\">\n    <meta property=\"og:description\" content=\"Parole italiane organizzate per ambienti, con immagini, frasi ed esercizi.\">\n    <meta property=\"og:url\" content=\"https://italianoconmartin.com/vocabolario/\">\n    <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/vocabolario/cucina-hero.webp\">\n    <link rel=\"stylesheet\" href=\"../styles.css?v=20260813d\">\n    <link rel=\"stylesheet\" href=\"../assets/vocabulary.css?v=20260814c\">\n    <link rel=\"icon\" href=\"/favicon.ico?v=20260813\" sizes=\"any\">\n    <link rel=\"icon\" href=\"/favicon.png?v=20260813\" type=\"image/png\" sizes=\"128x128\">\n    <link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png?v=20260813\">\n  </head>\n  <body>\n    <header class=\"site-header\">\n      <div class=\"container nav-wrap\">\n        <a class=\"brand\" href=\"../\"><img class=\"brand-avatar\" src=\"../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a>\n        <details class=\"language-switcher\"><summary aria-label=\"Scegli lingua\"><span class=\"language-flag\" aria-hidden=\"true\">🇮🇹</span><span class=\"language-current\">Italiano</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/vocabolario/\" hreflang=\"it\" lang=\"it\" aria-current=\"page\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/vocabulary/\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/vocabulario/\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/vocabulaire/\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/slovni-zasoba/\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/slownictwo/\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/kelime-bilgisi/\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/d