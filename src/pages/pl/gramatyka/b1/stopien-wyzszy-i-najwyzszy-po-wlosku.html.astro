name=\"robots\" content=\"index,follow,max-image-preview:large\"><meta name=\"author\" content=\"Martin Modena\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"Italiano con Martin\"><meta property=\"og:title\" content=\"Stopień wyższy i najwyższy po włosku | gramatyka włoska B1 | Italiano con Martin\"><meta property=\"og:description\" content=\"Ucz się porównań i superlatywów dzięki przykładom i interaktywnym ćwiczeniom.\"><meta property=\"og:url\" content=\"https://italianoconmartin.com/pl/gramatyka/b1/stopien-wyzszy-i-najwyzszy-po-wlosku.html\"><meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Stopień wyższy i najwyższy po włosku | gramatyka włoska B1 | Italiano con Martin\"><meta name=\"twitter:description\" content=\"Ucz się porównań i superlatywów dzięki przykładom i interaktywnym ćwiczeniom.\"><meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\"><link rel=\"stylesheet\" href=\"../../../styles.css?v=20260813d\"><link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\"><link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"Stopień wyższy i najwyższy po włosku\",\"url\":\"https://italianoconmartin.com/pl/gramatyka/b1/stopien-wyzszy-i-najwyzszy-po-wlosku.html\",\"inLanguage\":\"pl\"}</script></head><body data-lesson=\"martin-comparativo-superlativo-b1\"><header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/pl/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇵🇱</span><span class=\"language-current\">Polski</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/b1/comparativo-e-superlativo.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/b1/italian-comparative-and-superlative.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/b1/comparativo-y-superlativo-en-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/b1/comparatif-et-superlatif-en-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/b1/komparativ-a-superlativ-v-italstine.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/b1/stopien-wyzszy-i-najwyzszy-po-wlosku.html\" hreflang=\"pl\" lang=\"pl\" aria-current=\"page\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/b1/italyanca-karsilastirma-ve-ustunluk.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/b1/komparativ-und-superlativ-im-italienischen.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/b1/イタリア語の比較級と最上級.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/pl/gramatyka/\">Gramatyka</a><a href=\"/pl/czytanki/\">Odczyty</a><a href=\"/pl/slownictwo/\">Słownictwo</a><a class=\"about-link\" href=\"/pl/o-nas/\">O nas</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Zarezerwuj na Preply</a></nav></div></header><main><section class=\"page-intro\"><div class=\"container lesson-shell\"><p class=\"breadcrumbs\"><a href=\"/pl/\">Dom</a> / <a href=\"/pl/gramatyka/\">Gramatyka</a> / B1 / Stopień wyższy i najwyższy po włosku</p><p class=\"eyebrow\">Gramatyka B1</p><h1>Stopień wyższy i najwyższy po włosku</h1><p class=\"lead\">Porównaj ludzi, miejsca i pomysły: ciekawsze niż, tańsze niż, ładniejsze niż, bardzo przydatne.</p><div class=\"lesson-nav\"><a href=\"#regola\">Reguła</a><a href=\"#tabella\">Stół</a><a href=\"#esempi\">Przykłady</a><a href=\"#di-o-che\">Z czy czego?</a><a href=\"#traduzione\">Tłumaczenie</a><a href=\"#esercizi\">Ćwiczenia</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/pl/stopien-wyzszy-i-najwyzszy-po-wlosku-b1.pdf\" download=\"\">PDF B1</a></div></div></section><section class=\"section compact-top\"><div class=\"container lesson-shell\"><article class=\"lesson-box\" id=\"regola\"><h2>Trzy rodzaje porównań</h2><div class=\"example-grid\"><div class=\"example\"><strong>Maggioranza</strong><br>Roma è più grande di Pisa.</div><div class=\"example\"><strong>Minoranza</strong><br>Questo corso è meno caro di quello.</div><div class=\"example\"><strong>Uguaglianza</strong><br>Marco è alto come Luca.</div><div class=\"example\"><strong>Superlativo relativo</strong><br>È il libro più utile della classe.</div></div></article><article class=\"lesson-box\" id=\"tabella\"><h2>Główne formy</h2><table class=\"conj-table\"><thead><tr><th>Funzione</th><th>Struttura</th><th>Esempio</th></tr></thead><tbody><tr><td>Più</td><td>più + aggettivo + di</td><td>più veloce di me</td></tr><tr><td>Meno</td><td>meno + aggettivo + di</td><td>meno difficile di ieri</td></tr><tr><td>Uguale</td><td>come / quanto</td><td>gentile come te</td></tr><tr><td>Superlativo relativo</td><td>il / la / i / le + più</td><td>la più importante</td></tr><tr><td>Superlativo assoluto</td><td>molto + aggettivo / -issimo</td><td>molto bello / bellissimo</td></tr></tbody></table><p class=\"mini-note\"><strong>Uwaga:</strong> lepszy oznacza lepszy lub lepszy; gorsze oznacza gorsze lub mniej dobre.</p></article><article class=\"lesson-box\" id=\"esempi\"><h2>Prawdziwe przykłady</h2><div class=\"example-grid\"><div class=\"example\">Questo esercizio è più facile del precedente.</div><div class=\"example\">Il treno è meno comodo dell'aereo.</div><div class=\"example\">La mia città è bella come la tua.</div><div class=\"example\">Questo è il ristorante più famoso del quartiere.</div></div></article><article class=\"lesson-box\" id=\"di-o-che\"><h2><em>Przez</em> o <em>to</em>? Prosta zasada</h2><p>Zobacz, co jest porównywane dalej <strong>więcej</strong> o <strong>mniej</strong> i zadaj sobie to pytanie:</p><div class=\"example-grid\"><div class=\"example\"><strong>Due persone, cose o momenti?</strong><br>Stai confrontando la stessa caratteristica in due termini diversi: usa <strong>di</strong>.</div><div class=\"example\"><strong>Due caratteristiche o azioni dello stesso termine?</strong><br>Stai mettendo a confronto due aspetti dello stesso soggetto: usa <strong>che</strong>.</div></div><h3>Użyj <em>z</em>: ta sama cecha, dwa różne terminy</h3><p>Porównujesz jedną osobę z drugą, jedną rzecz z drugą lub jedną chwilę z inną.</p><div class=\"example-grid\"><div class=\"example\"><strong>Martin è più alto di Luca.</strong><br>Caratteristica: l’altezza. Persone: Martin e Luca.</div><div class=\"example\"><strong>Oggi fa più caldo di ieri.</strong><br>Caratteristica: la temperatura. Momenti: oggi e ieri.</div><div class=\"example\"><strong>Questo libro è meno lungo di quello.</strong><br>Caratteristica: la lunghezza. Cose: questo libro e quello.</div><div class=\"example\"><strong>Giulia corre più velocemente di me.</strong><br>Con i pronomi: <em>di me, di te, di lui, di lei, di noi, di voi, di loro</em>.</div></div><p class=\"mini-note\"><strong>Pamiętaj:</strong> przed rzeczownikiem z rodzajnikiem, <em>z</em> dołącza do artykułu: <em>z, z, z, z, z</em>. Na przykład: <em>Rzym jest większy niż moje miasto</em>.</p><h3>Użyj <em>to</em>: dwa aspekty tego samego terminu</h3><p>Porównujesz dwie cechy, dwie czynności, dwa rzeczowniki lub dwa wyrażenia za pomocą przyimka.</p><div class=\"example-grid\"><div class=\"example\"><strong>Due qualità</strong><br>Martin è più alto <strong>che</strong> generoso.<br>Il film è più lungo <strong>che</strong> difficile.</div><div class=\"example\"><strong>Due azioni</strong><br>È più facile leggere <strong>che</strong> scrivere.<br>Camminare è più salutare <strong>che</strong> prendere l’autobus.</div><div class=\"example\"><strong>Due nomi</strong><br>Abbiamo più fame <strong>che</strong> sete.<br>In casa ci sono più libri <strong>che</strong> riviste.</div><div class=\"example\"><strong>Due espressioni con preposizione</strong><br>Il viaggio è più comodo <strong>in treno che in autobus</strong>.<br>Studio più volentieri <strong>con Anna che con Paolo</strong>.</div></div><p class=\"lesson-note\"><strong>Szybka sztuczka:</strong> jeśli możesz powiedzieć „X kontra Y”, a X i Y to różne osoby, rzeczy lub czasy, wybierz <em>z</em>. Jeśli później <em>więcej/mniej</em> porównaj dwie cechy, działania lub alternatywy tego samego przedmiotu, wybierz <em>to</em>.</p></article><article class=\"lesson-box\"><h2><em>Lepiej</em> o <em>lepiej</em>?</h2><p><strong>Lepiej</strong> jest to porównanie przysłówka <em>dobrze</em>: modyfikuje czasownik lub pojawia się w wyrażeniach bezosobowych.</p><div class=\"example\">Pracuję dzisiaj <strong>lepiej</strong>.<br>È <strong>lepiej</strong> wyjdź wcześniej.</div><p><strong>Lepiej</strong> jest to stopień porównawczy przymiotnika <em>dobrze</em>: towarzyszy rzeczownikowi i zgadza się w liczbie mnogiej.</p><div class=\"example\">To jest rozwiązanie <strong>lepiej</strong>.<br>Te ćwiczenia są <strong>lepiej</strong>.</div><p class=\"lesson-note\">Nie mów <em>więcej lepiej</em> o <em>więcej lepiej</em>: są to już formy porównawcze.</p></article><article class=\"lesson-box\"><h2>Typowe błędy</h2><div class=\"mistake-grid\"><div class=\"mistake\"><strong>Non: più grande che me</strong>Ma: più grande di me.</div><div class=\"mistake\"><strong>Non: molto bellissimo</strong>Ma: molto bello oppure bellissimo.</div><div class=\"mistake\"><strong>Non: il più meglio</strong>Ma: il migliore.</div><div class=\"mistake\"><strong>Non: uguale di</strong>Ma: uguale a / come.</div></div></article><article class=\"lesson-box\" id=\"esercizi\"><h2>30 ćwiczeń z natychmiastową informacją zwrotną</h2><p>Uzupełnij odpowiednim formularzem. Ćwiczenia 11–22 skupiają się na <em>z</em> e <em>to</em>; te ostatnie wyróżniają <em>lepiej</em> e <em>lepiej</em>.</p><div id=\"exercise-list\"><div class=\"exercise\" data-answer=\"più\" data-alt=\"piu\" data-hint=\"W przypadku większości używamy więcej.\"><label>1. Milano è ___ grande di Parma.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meno\" data-hint=\"W przypadku mniejszości używamy mniej.\"><label>2. Questo hotel è ___ caro dell’altro.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"come\" data-alt=\"quanto\" data-hint=\"Dla równości używamy how lub how much.\"><label>3. Anna è simpatica ___ sua sorella.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"il più\" data-alt=\"il piu\" data-hint=\"Względny stopień męski liczby pojedynczej.\"><label>4. Questo è ___ bel film dell’anno.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"la più\" data-alt=\"la piu\" data-hint=\"Względny stopień żeński liczby pojedynczej.\"><label>5. È ___ brava della classe.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"bellissimo\" data-alt=\"molto bello\" data-hint=\"Użyj -issimo lub bardzo + przymiotnika.\"><label>6. Il panorama è ___. (molto bello)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliore\" data-hint=\"Najlepiej towarzyszy imieniu.\"><label>7. Questo vino è ___ di quello.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"peggiore\" data-hint=\"Gorszy oznacza mniej dobry.\"><label>8. Il tempo oggi è ___ di ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"Porównaj ten sam stan w dwóch różnych momentach.\"><label>9. Sono più stanco ___ ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"del\" data-alt=\"di\" data-hint=\"Przed „grupą” di + staje się del.\"><label>10. È il più giovane ___ gruppo.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"Porównaj wzrost dwóch osób.\"><label>11. Paolo è più alto ___ Marco.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"Porównaj tę samą jakość dwukrotnie.\"><label>12. Oggi sono meno preoccupato ___ ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"della\" data-alt=\"di quella\" data-hint=\"Di + staje się della.\"><label>13. La mia casa è più luminosa ___ tua.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"Porównaj użyteczność dwóch rzeczy.\"><label>14. Questo libro è più utile ___ quello.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"Z zaimkiem osobowym używamy di: of me.\"><label>15. Sara corre più velocemente ___ me.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"della\" data-hint=\"Di + staje się della.\"><label>16. La montagna è più tranquilla ___ città.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"Porównaj dwie cechy Martina.\"><label>17. Martin è più paziente ___ severo.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"Porównaj dwie cechy tego samego ćwiczenia.\"><label>18. Questo esercizio è più lungo ___ difficile.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"Porównaj dwie akcje.\"><label>19. È più facile leggere ___ scrivere.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"Porównaj dwie akcje.\"><label>20. Camminare è più salutare ___ prendere l’autobus.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"Porównaj dwie nazwy odnoszące się do tego samego przedmiotu.\"><label>21. Abbiamo più fame ___ sete.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"Porównaj dwie alternatywy wprowadzone przez przyimek.\"><label>22. Il viaggio è più comodo in treno ___ in autobus.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"Lepiej zmodyfikuj czasownik studiować.\"><label>23. Oggi studio ___ di ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"W bezosobowym wyrażeniu „jest lepiej” używamy przysłówka.\"><label>24. È ___ partire presto.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliore\" data-hint=\"Best towarzyszy nazwie metody.\"><label>25. Questo è un metodo ___.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliori\" data-hint=\"Migliori towarzyszy rzeczownikowi w liczbie mnogiej.\"><label>26. Queste scarpe sono ___ di quelle.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"Lepiej zmodyfikuj czasownik do pracy.\"><label>27. Con questo programma lavoro ___.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliore\" data-hint=\"Najlepiej towarzyszy wybranej nazwie.\"><label>28. È una scelta ___ della precedente.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"Lepiej zmodyfikuj czasownik śpiewać.\"><label>29. Luca canta ___ di me.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliori\" data-hint=\"Migliori zgadza się z rozwiązaniami w liczbie mnogiej.\"><label>30. Cerchiamo soluzioni ___.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div></div><div class=\"score-card\"><div><strong>Twój wynik</strong><p id=\"score-text\">0 poprawnych odpowiedzi na 30</p></div><strong id=\"score-percent\">0%</strong></div><div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">Zacznij od nowa</button><a class=\"button primary\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Trenuj z Martinem</a></div></article><article class=\"lesson-box translation-lab\" id=\"traduzione\"><h2>Przetłumacz na język włoski</h2><p>Napisz swoje zdanie, a następnie porównaj je z proponowanym rozwiązaniem. Nie ma jednego możliwego tłumaczenia: to działanie mierzy ukończenie, nie przypisuje prawdy ani fałszu.</p><div class=\"translation-grid\"><div class=\"translation-exercise\" data-translation-id=\"1\"><label for=\"translation-1\">1. Martin jest wyższy od Luca.</label><textarea id=\"translation-1\" rows=\"3\" placeholder=\"Wpisz tutaj swoje tłumaczenie…\"></textarea><div class=\"translation-actions\"><button type=\"button\" class=\"translation-toggle\">Pokaż rozwiązanie</button><button type=\"button\" class=\"translation-complete\">Oznacz jako ukończone</button></div><div class=\"translation-solution\" hidden=\"\"><strong>Proponowane rozwiązanie</strong><p lang=\"it\">Martin è più alto di Luca.</p></div><p class=\"translation-status\" aria-live=\"polite\"></p></div><div class=\"translation-exercise\" data-translation-id=\"2\"><label for=\"translation-2\">2. Martin jest wyższy niż hojny.</label><textarea id=\"translation-2\" rows=\"3\" placeholder=\"Wpisz tutaj swoje tłumaczenie…\"></textarea><div class=\"translation-actions\"><button type=\"button\" class=\"translation-toggle\">Pokaż rozwiązanie</button><button type=\"button\" class=\"translation-complete\">Oznacz jako ukończone</button></div><div class=\"translation-solution\" hidden=\"\"><strong>Proponowane rozwiązanie</strong><p lang=\"it\">Martin è più alto che generoso.</p></div><p class=\"translation-status\" aria-live=\"polite\"></p></div><div class=\"translation-exercise\" data-translation-id=\"3\"><label for=\"translation-3\">3. Lepiej byłoby wybrać lepsze rozwiązanie.</label><textarea id=\"translation-3\" rows=\"3\" placeholder=\"Wpisz tutaj swoje tłumaczenie…\"></textarea><div class=\"translation-actions\"><button type=\"button\" class=\"translation-toggle\">Pokaż rozwiązanie</button><button type=\"button\" class=\"translation-complete\">Oznacz jako ukończone</button></div><div class=\"translation-solution\" hidden=\"\"><strong>Proponowane rozwiązanie</strong><p lang=\"it\">Sarebbe meglio scegliere una soluzione migliore.</p></div><p class=\"translation-status\" aria-live=\"polite\"></p></div></div></article></div></section>