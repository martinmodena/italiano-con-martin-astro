const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: ja/bunpo/b2/イタリア語の-periodo-ipotetico.html -->\n<html lang=\"ja\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/grammatica/b2/periodo-ipotetico.html\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/grammar/b2/italian-periodo-ipotetico.html\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/gramatica/b2/periodo-ipotetico-en-italiano.html\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/grammaire/b2/periodo-ipotetico-en-italien.html\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/gramatika/b2/italsky-periodo-ipotetico.html\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/gramatyka/b2/wloski-periodo-ipotetico.html\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/dilbilgisi/b2/italyanca-periodo-ipotetico.html\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/grammatik/b2/der-italienische-periodo-ipotetico.html\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/bunpo/b2/イタリア語の-periodo-ipotetico.html\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/grammatica/b2/periodo-ipotetico.html\"><link rel=\"canonical\" href=\"https://italianoconmartin.com/ja/bunpo/b2/イタリア語の-periodo-ipotetico.html\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>イタリア語の periodo ipotetico | イタリア語文法 B2 | Italiano con Martin</title>\n  <meta name=\"description\" content=\"イタリアの仮説期間: 現実、可能性、非現実を例とインタラクティブな演習で学びます。\">\n\n\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n  <meta name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"イタリア語の periodo ipotetico | イタリア語文法 B2 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"イタリアの仮説期間: 現実、可能性、非現実を例とインタラクティブな演習で学びます。\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/ja/bunpo/b2/イタリア語の-periodo-ipotetico.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"イタリア語の periodo ipotetico | イタリア語文法 B2 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"イタリアの仮説期間: 現実、可能性、非現実を例とインタラクティブな演習で学びます。\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n  <link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\">\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"イタリア語の periodo ipotetico\",\"url\":\"https://italianoconmartin.com/ja/bunpo/b2/イタリア語の-periodo-ipotetico.html\",\"inLanguage\":\"ja\"}</script></head>\n<body data-lesson=\"martin-periodo-ipotetico-b2\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/ja/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇯🇵</span><span class=\"language-current\">日本語</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/b2/periodo-ipotetico.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/b2/italian-periodo-ipotetico.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/b2/periodo-ipotetico-en-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/b2/periodo-ipotetico-en-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/b2/italsky-periodo-ipotetico.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/b2/wloski-periodo-ipotetico.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/b2/italyanca-periodo-ipotetico.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/b2/der-italienische-periodo-ipotetico.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/b2/イタリア語の-periodo-ipotetico.html\" hreflang=\"ja\" lang=\"ja\" aria-current=\"page\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/ja/bunpo/\">文法</a><a href=\"/ja/dokkai/\">測定値</a><a href=\"/ja/goi/\">語彙</a><a class=\"about-link\" href=\"/ja/watashitachi-ni-tsuite/\">私たちについて</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Preplyで予約する</a></nav></div></header>\n<main>\n  <section class=\"page-intro\"><div class=\"container lesson-shell\"><p class=\"breadcrumbs\"><a href=\"/ja/\">ホーム</a> / <a href=\"/ja/bunpo/\">文法</a> / B2 / イタリア語の periodo ipotetico</p><p class=\"eyebrow\">文法B2</p><h1>イタリア語の periodo ipotetico</h1><p class=\"lead\">現実、可能性、想像上の状況など、自分自身で文章を組み立てることを学びます。</p><div class=\"lesson-meta\"><span>18分</span><span>10 の演習</span><span>レベルB2</span></div><div class=\"lesson-nav\"><a href=\"#tipi\">種類</a><a href=\"#possibile\">可能</a><a href=\"#irreale\">非現実的</a><a href=\"#esercizi\">演習</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/ja/イタリア語の-periodo-ipotetico-b2.pdf\" download=\"\">PDF B2</a></div></div></section>\n  <section class=\"section compact-top\"><div class=\"container lesson-shell\">\n    <article class=\"lesson-box\" id=\"tipi\"><h2>主な3つのタイプ</h2><table class=\"conj-table\"><thead><tr><th>Tipo</th><th>Struttura</th><th>Esempio</th></tr></thead><tbody><tr><td>Reale</td><td>se + presente, presente/futuro</td><td>Se studi, migliori.</td></tr><tr><td>Possibile</td><td>se + congiuntivo imperfetto, condizionale presente</td><td>Se studiassi di più, parleresti meglio.</td></tr><tr><td>Irreale nel passato</td><td>se + congiuntivo trapassato, condizionale passato</td><td>Se avessi studiato, avresti superato l'esame.</td></tr></tbody></table></article>\n    <article class=\"lesson-box\" id=\"possibile\"><h2>可能性のある仮説または想像上の仮説</h2><p>後から不完了仮定法を使います <strong>もし</strong> そして結果の条件付き現在。</p><div class=\"example-grid\"><div class=\"example\">Se avessi tempo, leggerei di più.</div><div class=\"example\">Se fossi in Italia, parlerei italiano ogni giorno.</div><div class=\"example\">Se potessi, farei una lezione con Martin.</div><div class=\"example\">Se studiassimo insieme, sarebbe più facile.</div></div></article>\n    <article class=\"lesson-box\" id=\"irreale\"><h2>過去の非現実的な仮説</h2><p>起こらなかったことについて話すとき、仮定法過去と条件法過去を使います。</p><div class=\"rule-grid\"><div class=\"rule-card\"><strong>知っていたら...</strong><br>もし答えを知っていたら、そう言っただろう。</div><div class=\"rule-card\"><strong>もし私が離れていたら...</strong><br>もっと早く出発していれば、間に合うように到着しただろう。</div><div class=\"rule-card\"><strong>持っていると</strong><br>私は食べただろうし、あなたも見たでしょう。</div><div class=\"rule-card\"><strong>存在とともに</strong><br>私が行ったら、あなたは到着したでしょう。</div></div></article>\n    <article class=\"lesson-box\"><h2>よくある間違い</h2><div class=\"mistake-grid\"><div class=\"mistake\"><strong>Errato: se avrei tempo.</strong>Corretto: se avessi tempo.</div><div class=\"mistake\"><strong>Errato: se sarei ricco.</strong>Corretto: se fossi ricco.</div><div class=\"mistake\"><strong>Errato: se studiavo, parlerei.</strong>Corretto: se studiassi, parlerei.</div><div class=\"mistake\"><strong>Errato: se avrei studiato.</strong>Corretto: se avessi studiato.</div></div></article>\n    <article class=\"lesson-box\" id=\"esercizi\"><h2>すぐにフィードバックが得られる演習</h2><p>正しいフォームで完了してください。</p><div class=\"exercise\" data-answer=\"studiassi\" data-hint=\"if の後に、可能仮説では不完了仮定法を使用します。\"><label>1. Se tu ___ di più, parleresti meglio. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"avessi\" data-hint=\"不完了仮定法の have: 私は持っていました。\"><label>2. Se io ___ tempo, leggerei. (avere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"fossi\" data-hint=\"不完了仮定法であること：私はそうでした。\"><label>3. Se lei ___ qui, sarebbe felice. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"andrei\" data-hint=\"結果: 現在条件付き。\"><label>4. Se potessi, ___ in Italia. (andare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"farebbe\" data-hint=\"彼/彼女 + 条件文で do: would です。\"><label>5. Se avesse tempo, Marco ___ una lezione. (fare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"avessimo studiato\" data-hint=\"過去の非現実：仮定法過去形。\"><label>6. Se noi ___, avremmo capito. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"sarei arrivato\" data-alt=\"sarei arrivata\" data-hint=\"到着すると、次のようになります。\"><label>7. Se fossi partito prima, ___ in tempo. (arrivare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"avresti visto\" data-hint=\"to have を含む過去条件: 見たことがあるでしょう。\"><label>8. Se fossi venuto, ___ il film. (vedere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliorerai\" data-hint=\"実期間: if + 現在、未来。\"><label>9. Se studi ogni giorno, ___. (migliorare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"parlerei\" data-hint=\"想像上の結果: 現在の条件付き。\"><label>10. Se fossi meno timido, ___ di più. (parlare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"score-card\"><div><strong>あなたの結果</strong><p id=\"score-text\">10 問中 0 問正解</p></div><strong id=\"score-percent\">0%</strong></div><div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">もう一度始める</button><a class=\"button primary\" href=\"../\">文法に戻る</a></div></article>\n  </div></section>\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>一緒にイタリア語を学ぶ先生を選ぶ</h2></div><p>二人の先生、二つの視点。興味に合った学び方を選べます。</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>科学・テクノロジー・語源</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Martinと学ぶ</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>芸術・忍耐・文法</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Liciaと学ぶ</a></article></div><div class=\"teacher-cta-links\"><a href=\"/ja/watashitachi-ni-tsuite/\">MartinとLiciaについて</a><a href=\"https://wa.me/59167434075?text=Martin%E3%81%BE%E3%81%9F%E3%81%AFLicia%E3%81%AE%E3%82%A4%E3%82%BF%E3%83%AA%E3%82%A2%E8%AA%9E%E3%83%AC%E3%83%83%E3%82%B9%E3%83%B3%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%E7%9F%A5%E3%82%8A%E3%81%9F%E3%81%84%E3%81%A7%E3%81%99%E3%80%82\" target=\"_blank\" rel=\"noopener\">WhatsAppで相談</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>明確な文法、段階別のリーディング、オンライン レッスン。</p></div><div><a href=\"/ja/bunpo/\">文法</a><a href=\"/ja/dokkai/\">測定値</a><a href=\"/ja/goi/\">語彙</a><a class=\"about-link\" href=\"/ja/watashitachi-ni-tsuite/\">私たちについて</a></div></div></footer><script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n</body></html>";
