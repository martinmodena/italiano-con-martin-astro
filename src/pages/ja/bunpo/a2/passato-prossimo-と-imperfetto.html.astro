const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: ja/bunpo/a2/passato-prossimo-と-imperfetto.html -->\n<html lang=\"ja\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/grammatica/a2/passato-prossimo-o-imperfetto.html\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/grammar/a2/passato-prossimo-vs-imperfetto.html\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/gramatica/a2/passato-prossimo-o-imperfetto.html\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/grammaire/a2/passato-prossimo-ou-imperfetto.html\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/gramatika/a2/passato-prossimo-nebo-imperfetto.html\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/gramatyka/a2/passato-prossimo-czy-imperfetto.html\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/dilbilgisi/a2/passato-prossimo-mu-imperfetto-mu.html\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/grammatik/a2/passato-prossimo-oder-imperfetto.html\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/bunpo/a2/passato-prossimo-と-imperfetto.html\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/grammatica/a2/passato-prossimo-o-imperfetto.html\"><link rel=\"canonical\" href=\"https://italianoconmartin.com/ja/bunpo/a2/passato-prossimo-と-imperfetto.html\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Passato prossimo と imperfetto の違い | イタリア語文法 A2 | Italiano con Martin</title>\n  <meta name=\"description\" content=\"明確な比較、例、インタラクティブな演習を使って、イタリア語で過去完了と不完了をいつ使用するかを学びます。\">\n\n\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n  <meta name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"Passato prossimo と imperfetto の違い | イタリア語文法 A2 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"明確な比較、例、インタラクティブな演習を使って、イタリア語で過去完了と不完了をいつ使用するかを学びます。\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/ja/bunpo/a2/passato-prossimo-と-imperfetto.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"Passato prossimo と imperfetto の違い | イタリア語文法 A2 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"明確な比較、例、インタラクティブな演習を使って、イタリア語で過去完了と不完了をいつ使用するかを学びます。\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n<link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"Passato prossimo と imperfetto の違い\",\"url\":\"https://italianoconmartin.com/ja/bunpo/a2/passato-prossimo-と-imperfetto.html\",\"inLanguage\":\"ja\"}</script></head>\n<body data-lesson=\"martin-passato-imperfetto-a2\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/ja/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇯🇵</span><span class=\"language-current\">日本語</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/a2/passato-prossimo-o-imperfetto.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/a2/passato-prossimo-vs-imperfetto.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/a2/passato-prossimo-o-imperfetto.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/a2/passato-prossimo-ou-imperfetto.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/a2/passato-prossimo-nebo-imperfetto.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/a2/passato-prossimo-czy-imperfetto.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/a2/passato-prossimo-mu-imperfetto-mu.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/a2/passato-prossimo-oder-imperfetto.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/a2/passato-prossimo-と-imperfetto.html\" hreflang=\"ja\" lang=\"ja\" aria-current=\"page\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/ja/bunpo/\">文法</a><a href=\"/ja/dokkai/\">測定値</a><a href=\"/ja/goi/\">語彙</a><a class=\"about-link\" href=\"/ja/watashitachi-ni-tsuite/\">私たちについて</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Preplyで予約する</a></nav></div></header>\n<main>\n  <section class=\"page-intro\">\n    <div class=\"container lesson-shell\">\n      <p class=\"breadcrumbs\"><a href=\"/ja/\">ホーム</a> / <a href=\"/ja/bunpo/\">文法</a> / A2 / Passato prossimo と imperfetto の違い</p>\n      <p class=\"eyebrow\">文法A2</p>\n      <h1>Passato prossimo と imperfetto の違い</h1>\n      <p class=\"lead\">完了した行動、習慣、説明、進行中の状況の中から選択する方法を学びましょう。</p>\n      <div class=\"lesson-meta\"><span>16分</span><span>12の演習</span><span>レベルA2</span></div>\n      <div class=\"lesson-nav\"><a href=\"#scelta\">選択</a><a href=\"#confronti\">比較</a><a href=\"#errori\">エラー</a><a href=\"#esercizi\">演習</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/ja/passato-prossimo-と-imperfetto-a2.pdf\" download=\"\">PDF A2</a></div>\n    </div>\n  </section>\n\n  <section class=\"section compact-top\">\n    <div class=\"container lesson-shell\">\n      <article class=\"lesson-box\" id=\"scelta\">\n        <h2>主な違い</h2>\n        <div class=\"rule-grid\">\n          <div class=\"rule-card\"><strong>現在完了</strong><br>有限な行動、正確な出来事。<br><em>昨日私はイタリア語を勉強しました。</em></div>\n          <div class=\"rule-card\"><strong>不完全な</strong><br>習慣、説明、状況。<br><em>子供の頃、私はほとんど勉強しませんでした。</em></div>\n          <div class=\"rule-card\"><strong>イベント</strong><br><em>8時に私は出かけました。</em></div>\n          <div class=\"rule-card\"><strong>コンテキスト</strong><br><em>遅くなって雨が降ってきました。</em></div>\n        </div>\n        <p class=\"italian-box\"><strong>便利なトリック:</strong> 「何が起こったのですか?」と言える場合は、現在完了をよく使います。 「状況はどのようなものでしたか?」を説明する場合、不完了時制を使用することがよくあります。</p>\n      </article>\n\n      <article class=\"lesson-box\" id=\"confronti\">\n        <h2>明確な比較</h2>\n        <table class=\"conj-table\">\n          <thead><tr><th>Situazione</th><th>Tempo</th><th>Esempio</th></tr></thead>\n          <tbody>\n            <tr><td>Azione conclusa</td><td>Passato prossimo</td><td>Ho finito il corso.</td></tr>\n            <tr><td>Abitudine nel passato</td><td>Imperfetto</td><td>Andavo al corso ogni martedi.</td></tr>\n            <tr><td>Descrizione</td><td>Imperfetto</td><td>La lezione era interessante.</td></tr>\n            <tr><td>Azione che interrompe</td><td>Passato prossimo</td><td>Mentre studiavo, ha chiamato Anna.</td></tr>\n            <tr><td>Azione in corso</td><td>Imperfetto</td><td>Mentre studiavo, ha chiamato Anna.</td></tr>\n          </tbody>\n        </table>\n        <h3>ミニストーリー</h3>\n        <p>いつ <strong>私は住んでいました</strong> ローマでは、 <strong>私は取った</strong> たいていバス。ある日 <strong>会いました</strong> 古い友人と <strong>私たちは話しました</strong> 1時間。</p>\n      </article>\n\n      <article class=\"lesson-box\" id=\"errori\">\n        <h2>ほぼ誰もが犯す間違い</h2>\n        <div class=\"mistake-grid\">\n          <div class=\"mistake\"><strong>Errato: Da bambino ho giocato ogni giorno.</strong>Meglio: da bambino giocavo ogni giorno.</div>\n          <div class=\"mistake\"><strong>Errato: Ieri andavo al cinema.</strong>Meglio: ieri sono andato al cinema.</div>\n          <div class=\"mistake\"><strong>Errato: Era caduto mentre camminava.</strong>Meglio A2: e caduto mentre camminava.</div>\n          <div class=\"mistake\"><strong>Errato: Quando ho avuto 10 anni...</strong>Meglio: quando avevo 10 anni...</div>\n        </div>\n      </article>\n\n      <article class=\"lesson-box\" id=\"esercizi\">\n        <h2>すぐにフィードバックが得られる演習</h2>\n        <p>正しいフォームを選択して記入してください。</p>\n        <div class=\"exercise\" data-answer=\"ho studiato\" data-hint=\"昨日は完了した出来事、つまり完全な過去を示します。\"><label>1. Ieri ___ italiano. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"studiavo\" data-hint=\"毎晩、習慣が不完全であることを示しています。\"><label>2. Quando ero studente, ___ ogni sera. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"era\" data-hint=\"状況の説明: 不完全。\"><label>3. La casa ___ molto piccola. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"sono uscito\" data-answer-fem=\"sono uscita\" data-alt=\"sono uscita\" data-hint=\"完了したアクション: 完全な過去。\"><label>4. Alle otto ___ di casa. (uscire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"pioveva\" data-hint=\"時間について説明します: 不完全。\"><label>5. Quando sono uscito, ___. (piovere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"ha telefonato\" data-hint=\"中断動作: 現在完了。\"><label>6. Mentre cucinavo, Marco ___. (telefonare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"cucinavo\" data-hint=\"現在のアクション: 不完全。\"><label>7. Mentre ___, Marco ha telefonato. (cucinare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"avevo\" data-hint=\"過去の年齢: 不完全。\"><label>8. Quando ___ dieci anni, vivevo in campagna. (avere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"ho comprato\" data-hint=\"イベント終了: 完璧な過去。\"><label>9. Sabato ___ un libro. (comprare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"leggevo\" data-hint=\"過去の習慣：不完全。\"><label>10. Da piccolo ___ molte favole. (leggere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"sono arrivato\" data-alt=\"sono arrivata|siamo arrivati|siamo arrivate\" data-hint=\"イベント終了: 完璧な過去。 「到着」では、「私は到着しました」または「到着しました」となります。\"><label>11. Alla fine ___ a Roma. (arrivare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"faceva\" data-hint=\"時制の説明: 不完全。\"><label>12. In montagna ___ freddo. (fare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"score-card\"><div><strong>あなたの結果</strong><p id=\"score-text\">12 問中 0 問正解</p></div><strong id=\"score-percent\">0%</strong></div>\n        <div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">もう一度始める</button><a class=\"button primary\" href=\"../\">文法に戻る</a></div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>一緒にイタリア語を学ぶ先生を選ぶ</h2></div><p>二人の先生、二つの視点。興味に合った学び方を選べます。</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>科学・テクノロジー・語源</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Martinと学ぶ</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>芸術・忍耐・文法</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Liciaと学ぶ</a></article></div><div class=\"teacher-cta-links\"><a href=\"/ja/watashitachi-ni-tsuite/\">MartinとLiciaについて</a><a href=\"https://wa.me/59167434075?text=Martin%E3%81%BE%E3%81%9F%E3%81%AFLicia%E3%81%AE%E3%82%A4%E3%82%BF%E3%83%AA%E3%82%A2%E8%AA%9E%E3%83%AC%E3%83%83%E3%82%B9%E3%83%B3%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%E7%9F%A5%E3%82%8A%E3%81%9F%E3%81%84%E3%81%A7%E3%81%99%E3%80%82\" target=\"_blank\" rel=\"noopener\">WhatsAppで相談</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>明確な文法、段階別のリーディング、オンライン レッスン。</p></div><div><a href=\"/ja/bunpo/\">文法</a><a href=\"/ja/dokkai/\">測定値</a><a href=\"/ja/goi/\">語彙</a><a class=\"about-link\" href=\"/ja/watashitachi-ni-tsuite/\">私たちについて</a></div></div></footer>\n<script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n\n</body></html>";
