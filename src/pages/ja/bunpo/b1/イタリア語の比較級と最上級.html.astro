roperty=\"og:site_name\" content=\"Italiano con Martin\"><meta property=\"og:title\" content=\"イタリア語の比較級と最上級 | イタリア語文法 B1 | Italiano con Martin\"><meta property=\"og:description\" content=\"例とインタラクティブな演習で比較級と最上級を学びます。\"><meta property=\"og:url\" content=\"https://italianoconmartin.com/ja/bunpo/b1/イタリア語の比較級と最上級.html\"><meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"イタリア語の比較級と最上級 | イタリア語文法 B1 | Italiano con Martin\"><meta name=\"twitter:description\" content=\"例とインタラクティブな演習で比較級と最上級を学びます。\"><meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\"><link rel=\"stylesheet\" href=\"../../../styles.css?v=20260813d\"><link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\"><link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"イタリア語の比較級と最上級\",\"url\":\"https://italianoconmartin.com/ja/bunpo/b1/イタリア語の比較級と最上級.html\",\"inLanguage\":\"ja\"}</script></head><body data-lesson=\"martin-comparativo-superlativo-b1\"><header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/ja/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇯🇵</span><span class=\"language-current\">日本語</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/b1/comparativo-e-superlativo.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/b1/italian-comparative-and-superlative.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/b1/comparativo-y-superlativo-en-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/b1/comparatif-et-superlatif-en-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/b1/komparativ-a-superlativ-v-italstine.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/b1/stopien-wyzszy-i-najwyzszy-po-wlosku.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/b1/italyanca-karsilastirma-ve-ustunluk.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/b1/komparativ-und-superlativ-im-italienischen.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/b1/イタリア語の比較級と最上級.html\" hreflang=\"ja\" lang=\"ja\" aria-current=\"page\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/ja/bunpo/\">文法</a><a href=\"/ja/dokkai/\">測定値</a><a href=\"/ja/goi/\">語彙</a><a class=\"about-link\" href=\"/ja/watashitachi-ni-tsuite/\">私たちについて</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Preplyで予約する</a></nav></div></header><main><section class=\"page-intro\"><div class=\"container lesson-shell\"><p class=\"breadcrumbs\"><a href=\"/ja/\">ホーム</a> / <a href=\"/ja/bunpo/\">文法</a> / B1 / イタリア語の比較級と最上級</p><p class=\"eyebrow\">文法B1</p><h1>イタリア語の比較級と最上級</h1><p class=\"lead\">人、場所、アイデアを比較します。より興味深い、より安い、より良い、非常に便利です。</p><div class=\"lesson-nav\"><a href=\"#regola\">ルール</a><a href=\"#tabella\">テーブル</a><a href=\"#esempi\">例</a><a href=\"#di-o-che\">それとも何？</a><a href=\"#traduzione\">翻訳</a><a href=\"#esercizi\">演習</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/ja/イタリア語の比較級と最上級-b1.pdf\" download=\"\">PDF B1</a></div></div></section><section class=\"section compact-top\"><div class=\"container lesson-shell\"><article class=\"lesson-box\" id=\"regola\"><h2>3種類の比較</h2><div class=\"example-grid\"><div class=\"example\"><strong>Maggioranza</strong><br>Roma è più grande di Pisa.</div><div class=\"example\"><strong>Minoranza</strong><br>Questo corso è meno caro di quello.</div><div class=\"example\"><strong>Uguaglianza</strong><br>Marco è alto come Luca.</div><div class=\"example\"><strong>Superlativo relativo</strong><br>È il libro più utile della classe.</div></div></article><article class=\"lesson-box\" id=\"tabella\"><h2>主な形式</h2><table class=\"conj-table\"><thead><tr><th>Funzione</th><th>Struttura</th><th>Esempio</th></tr></thead><tbody><tr><td>Più</td><td>più + aggettivo + di</td><td>più veloce di me</td></tr><tr><td>Meno</td><td>meno + aggettivo + di</td><td>meno difficile di ieri</td></tr><tr><td>Uguale</td><td>come / quanto</td><td>gentile come te</td></tr><tr><td>Superlativo relativo</td><td>il / la / i / le + più</td><td>la più importante</td></tr><tr><td>Superlativo assoluto</td><td>molto + aggettivo / -issimo</td><td>molto bello / bellissimo</td></tr></tbody></table><p class=\"mini-note\"><strong>注意:</strong> better は、より良い、より良いという意味です。 「悪い」は、より悪い、またはあまり良くないことを意味します。</p></article><article class=\"lesson-box\" id=\"esempi\"><h2>実際の例</h2><div class=\"example-grid\"><div class=\"example\">Questo esercizio è più facile del precedente.</div><div class=\"example\">Il treno è meno comodo dell'aereo.</div><div class=\"example\">La mia città è bella come la tua.</div><div class=\"example\">Questo è il ristorante più famoso del quartiere.</div></div></article><article class=\"lesson-box\" id=\"di-o-che\"><h2><em>によって</em> o <em>それ</em>?簡単なルール</h2><p>次に比較されるものを見てください <strong>もっと見る</strong> o <strong>少ない</strong> そして次の質問を自分自身に問いかけてください。</p><div class=\"example-grid\"><div class=\"example\"><strong>Due persone, cose o momenti?</strong><br>Stai confrontando la stessa caratteristica in due termini diversi: usa <strong>di</strong>.</div><div class=\"example\"><strong>Due caratteristiche o azioni dello stesso termine?</strong><br>Stai mettendo a confronto due aspetti dello stesso soggetto: usa <strong>che</strong>.</div></div><h3>使用する <em>の</em>: 同じ特性、2 つの異なる用語</h3><p>ある人物と別の人物、ある物事と別の物事、またはある瞬間と別の瞬間を比較します。</p><div class=\"example-grid\"><div class=\"example\"><strong>Martin è più alto di Luca.</strong><br>Caratteristica: l’altezza. Persone: Martin e Luca.</div><div class=\"example\"><strong>Oggi fa più caldo di ieri.</strong><br>Caratteristica: la temperatura. Momenti: oggi e ieri.</div><div class=\"example\"><strong>Questo libro è meno lungo di quello.</strong><br>Caratteristica: la lunghezza. Cose: questo libro e quello.</div><div class=\"example\"><strong>Giulia corre più velocemente di me.</strong><br>Con i pronomi: <em>di me, di te, di lui, di lei, di noi, di voi, di loro</em>.</div></div><p class=\"mini-note\"><strong>覚えておいてください:</strong> 冠詞のある名詞の前に、 <em>の</em> 記事に参加します: <em>の、の、の、の、の、の</em>。たとえば: <em>ローマは私の街より大きい</em>.</p><h3>使用する <em>それ</em>: 同じ用語の 2 つの側面</h3><p>2 つの性質、2 つの動作、2 つの名詞、または前置詞を含む 2 つの表現を比較します。</p><div class=\"example-grid\"><div class=\"example\"><strong>Due qualità</strong><br>Martin è più alto <strong>che</strong> generoso.<br>Il film è più lungo <strong>che</strong> difficile.</div><div class=\"example\"><strong>Due azioni</strong><br>È più facile leggere <strong>che</strong> scrivere.<br>Camminare è più salutare <strong>che</strong> prendere l’autobus.</div><div class=\"example\"><strong>Due nomi</strong><br>Abbiamo più fame <strong>che</strong> sete.<br>In casa ci sono più libri <strong>che</strong> riviste.</div><div class=\"example\"><strong>Due espressioni con preposizione</strong><br>Il viaggio è più comodo <strong>in treno che in autobus</strong>.<br>Studio più volentieri <strong>con Anna che con Paolo</strong>.</div></div><p class=\"lesson-note\"><strong>簡単なトリック:</strong> 「X 対 Y」と言え、X と Y は異なる人、物、または時代である場合は、選択してください <em>の</em>。後であれば <em>多い/少ない</em> 同じ主題の 2 つの性質、行動、または代替案を比較し、選択する <em>それ</em>.</p></article><article class=\"lesson-box\"><h2><em>より良い</em> o <em>より良い</em>?</h2><p><strong>より良い</strong> それは副詞の比較級です <em>良い</em>: 動詞を修飾するか、非人称表現に現れます。</p><div class=\"example\">今日は仕事です <strong>より良い</strong>.<br>È <strong>より良い</strong> 早めに出発します。</div><p><strong>より良い</strong> それは形容詞の比較級です <em>良い</em>: 名詞に付随し、複数形で一致します。</p><div class=\"example\">これは解決策です <strong>より良い</strong>.<br>これらの練習は、 <strong>より良い</strong>.</div><p class=\"lesson-note\">言わないでください <em>もっと良い</em> o <em>もっと良い</em>: これらはすでに比較級です。</p></article><article class=\"lesson-box\"><h2>よくある間違い</h2><div class=\"mistake-grid\"><div class=\"mistake\"><strong>Non: più grande che me</strong>Ma: più grande di me.</div><div class=\"mistake\"><strong>Non: molto bellissimo</strong>Ma: molto bello oppure bellissimo.</div><div class=\"mistake\"><strong>Non: il più meglio</strong>Ma: il migliore.</div><div class=\"mistake\"><strong>Non: uguale di</strong>Ma: uguale a / come.</div></div></article><article class=\"lesson-box\" id=\"esercizi\"><h2>即時フィードバック付きの 30 の演習</h2><p>正しいフォームで完了してください。演習 11 ～ 22 では、以下に焦点を当てます。 <em>の</em> e <em>それ</em>;後者は区別します <em>より良い</em> e <em>より良い</em>.</p><div id=\"exercise-list\"><div class=\"exercise\" data-answer=\"più\" data-alt=\"piu\" data-hint=\"ほとんどの場合、それ以上を使用します。\"><label>1. Milano è ___ grande di Parma.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meno\" data-hint=\"少数派の場合は、使用量を減らします。\"><label>2. Questo hotel è ___ caro dell’altro.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"come\" data-alt=\"quanto\" data-hint=\"平等の場合は、「方法」または「金額」を使用します。\"><label>3. Anna è simpatica ___ sua sorella.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"il più\" data-alt=\"il piu\" data-hint=\"男性単数の関係格最上級。\"><label>4. Questo è ___ bel film dell’anno.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"la più\" data-alt=\"la piu\" data-hint=\"女性の相対格単数最上級。\"><label>5. È ___ brava della classe.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"bellissimo\" data-alt=\"molto bello\" data-hint=\"-issimo または Very + 形容詞を使用します。\"><label>6. Il panorama è ___. (molto bello)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliore\" data-hint=\"ベストには名前が付きます。\"><label>7. Questo vino è ___ di quello.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"peggiore\" data-hint=\"悪いということは、良くないことを意味します。\"><label>8. Il tempo oggi è ___ di ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"2 つの異なる時点で同じ条件を比較します。\"><label>9. Sono più stanco ___ ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"del\" data-alt=\"di\" data-hint=\"「グループ」の前では、di + が del になります。\"><label>10. È il più giovane ___ gruppo.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"二人の身長を比べてみましょう。\"><label>11. Paolo è più alto ___ Marco.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"同じ品質を 2 回比較します。\"><label>12. Oggi sono meno preoccupato ___ ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"della\" data-alt=\"di quella\" data-hint=\"Di + はデラになります。\"><label>13. La mia casa è più luminosa ___ tua.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"2 つのものの有用性を比較します。\"><label>14. Questo libro è più utile ___ quello.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"di\" data-hint=\"人称代名詞では di: of me を使用します。\"><label>15. Sara corre più velocemente ___ me.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"della\" data-hint=\"Di + はデラになります。\"><label>16. La montagna è più tranquilla ___ città.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"マーティンの 2 つの特質を比較してください。\"><label>17. Martin è più paziente ___ severo.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"同じエクササイズの 2 つの性質を比較します。\"><label>18. Questo esercizio è più lungo ___ difficile.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"2つの銘柄を比較します。\"><label>19. È più facile leggere ___ scrivere.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"2つの銘柄を比較します。\"><label>20. Camminare è più salutare ___ prendere l’autobus.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"同じ主題を指す 2 つの名前を比較します。\"><label>21. Abbiamo più fame ___ sete.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"che\" data-hint=\"前置詞によって導入された 2 つの選択肢を比較します。\"><label>22. Il viaggio è più comodo in treno ___ in autobus.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"「勉強する」という動詞を修正した方がよいでしょう。\"><label>23. Oggi studio ___ di ieri.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"「それはより良いです」という非個人的な表現では、副詞を使用します。\"><label>24. È ___ partire presto.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliore\" data-hint=\"Best はメソッド名に付けられます。\"><label>25. Questo è un metodo ___.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliori\" data-hint=\"Migliori は複数名詞を伴います。\"><label>26. Queste scarpe sono ___ di quelle.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"動作するように動詞を修正した方がよいでしょう。\"><label>27. Con questo programma lavoro ___.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliore\" data-hint=\"選択した名前に最適です。\"><label>28. È una scelta ___ della precedente.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"meglio\" data-hint=\"動詞を「歌う」に修正したほうがよいでしょう。\"><label>29. Luca canta ___ di me.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"migliori\" data-hint=\"Migliori 氏は複数の解決策に同意します。\"><label>30. Cerchiamo soluzioni ___.</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div></div><div class=\"score-card\"><div><strong>あなたの結果</strong><p id=\"score-text\">30 問中 0 問正解</p></div><strong id=\"score-percent\">0%</strong></div><div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">もう一度始める</button><a class=\"button primary\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">マーティンと一緒にトレーニングする</a></div></article><article class=\"lesson-box translation-lab\" id=\"traduzione\"><h2>イタリア語に翻訳する</h2><p>文章を書き、提案された解決策と比較します。可能な翻訳は 1 つだけではありません。このアクティビティは完了を測定するものであり、true または false を割り当てません。</p><div class=\"translation-grid\"><div class=\"translation-exercise\" data-translation-id=\"1\"><label for=\"translation-1\">1. マーティンはルカより背が高いです。</label><textarea id=\"translation-1\" rows=\"3\" placeholder=\"ここに翻訳を書いてください…\"></textarea><div class=\"translation-actions\"><button type=\"button\" class=\"translation-toggle\">解決策を示す</button><button type=\"button\" class=\"translation-complete\">完了としてマークする</button></div><div class=\"translation-solution\" hidden=\"\"><strong>提案されたソリューション</strong><p lang=\"it\">Martin è più alto di Luca.</p></div><p class=\"translation-status\" aria-live=\"polite\"></p></div><div class=\"translation-exercise\" data-translation-id=\"2\"><label for=\"translation-2\">2. マーティンは寛大であるよりも背が高い。</label><textarea id=\"translation-2\" rows=\"3\" placeholder=\"ここに翻訳を書いてください…\"></textarea><div class=\"translation-actions\"><button type=\"button\" class=\"translation-toggle\">解決策を示す</button><button type=\"button\" class=\"translation-complete\">完了としてマークする</button></div><div class=\"translation-solution\" hidden=\"\"><strong>提案されたソリューション</strong><p lang=\"it\">Martin è più alto che generoso.</p></div><p class=\"translation-status\" aria-live=\"polite\"></p></div><div class=\"translation-exercise\" data-translation-id=\"3\"><label for=\"translation-3\">3. より良い解決策を選択した方がよいでしょう。</label><textarea id=\"translation-3\" rows=\"3\" placeholder=\"ここに翻訳を書いてください…\"></textarea><div class=\"translation-actions\"><button type=\"button\" class=\"translation-toggle\">解決策を示す</button><button type=\"button\" class=\"translation-complete\">完了としてマークする</button></div><div class=\"translation-solution\" hidden=\"\"><strong>提案されたソリューション</strong><p lang=\"it\">Sarebbe meglio scegliere una soluzione migliore.</p></div><p class=\"translation-status\" aria-live=\"polite\"></p></div></div></article></div></section><section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p c