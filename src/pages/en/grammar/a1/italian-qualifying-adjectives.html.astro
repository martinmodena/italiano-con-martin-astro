a name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"Italian qualifying adjectives | Italian grammar A1 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"Learn qualifying adjectives in Italian: agreement with gender and number, position, examples and interactive exercises.\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/en/grammar/a1/italian-qualifying-adjectives.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"Italian qualifying adjectives | Italian grammar A1 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"Learn qualifying adjectives in Italian: agreement with gender and number, position, examples and interactive exercises.\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n<link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"Italian qualifying adjectives\",\"url\":\"https://italianoconmartin.com/en/grammar/a1/italian-qualifying-adjectives.html\",\"inLanguage\":\"en\"}</script></head>\n<body data-lesson=\"martin-aggettivi-a1\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/en/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇬🇧</span><span class=\"language-current\">English</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/a1/aggettivi-qualificativi.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/a1/italian-qualifying-adjectives.html\" hreflang=\"en\" lang=\"en\" aria-current=\"page\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/a1/adjetivos-calificativos-en-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/a1/adjectifs-qualificatifs-en-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/a1/italska-pridavna-jmena.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/a1/wloskie-przymiotniki-kwalifikujace.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/a1/italyanca-niteleme-sifatlari.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/a1/italienische-adjektive.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/a1/イタリア語の形容詞.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/en/grammar/\">Grammar</a><a href=\"/en/readings/\">Readings</a><a href=\"/en/vocabulary/\">Vocabulary</a><a class=\"about-link\" href=\"/en/about-us/\">About us</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Book on Preply</a></nav></div></header>\n<main>\n  <section class=\"page-intro\"><div class=\"container lesson-shell\"><p class=\"breadcrumbs\"><a href=\"/en/\">Home</a> / <a href=\"/en/grammar/\">Grammar</a> / A1 / Italian qualifying adjectives</p><p class=\"eyebrow\">Grammar A1</p><h1>Italian qualifying adjectives</h1><p class=\"lead\">Learn to describe people, objects and places: beautiful, large, interesting, Italian.</p><div class=\"lesson-meta\"><span>10 minutes</span><span>10 exercises</span><span>Level A1</span></div><div class=\"lesson-nav\"><a href=\"#accordo\">Agreement</a><a href=\"#posizione\">Location</a><a href=\"#errori\">Errors</a><a href=\"#esercizi\">Exercises</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/en/italian-qualifying-adjectives-a1.pdf\" download=\"\">PDF A1</a></div></div></section>\n  <section class=\"section compact-top\"><div class=\"container lesson-shell\">\n    <article class=\"lesson-box\" id=\"accordo\">\n      <h2>The most important rule</h2>\n      <p>The adjective changes with the noun: masculine, feminine, singular and plural.</p>\n      <table class=\"conj-table\"><thead><tr><th>Tipo</th><th>Singolare</th><th>Plurale</th></tr></thead><tbody><tr><td>Maschile</td><td>un libro nuovo</td><td>libri nuovi</td></tr><tr><td>Femminile</td><td>una casa nuova</td><td>case nuove</td></tr><tr><td>Aggettivi in -e</td><td>un corso interessante</td><td>corsi interessanti</td></tr></tbody></table>\n      <p class=\"mini-note\"><strong>Remember:</strong> many adjectives in <strong>-e</strong> are equal to the masculine and feminine singular: an interesting film, an interesting lesson.</p>\n    </article>\n\n    <article class=\"lesson-box\" id=\"posizione\">\n      <h2>Where do we put the adjective?</h2>\n      <p>The adjective usually goes after the noun, especially when it describes a concrete quality.</p>\n      <div class=\"example-grid\"><div class=\"example\">una macchina rossa</div><div class=\"example\">un ragazzo gentile</div><div class=\"example\">una lezione utile</div><div class=\"example\">un esercizio facile</div></div>\n      <p>Some very common adjectives can go before the noun: <strong>a beautiful day</strong>, <strong>a good idea</strong>, <strong>a little problem</strong>.</p>\n    </article>\n\n    <article class=\"lesson-box\" id=\"errori\">\n      <h2>Mistakes that almost everyone makes</h2>\n      <div class=\"mistake-grid\"><div class=\"mistake\"><strong>Errato: una casa nuovo.</strong>Corretto: una casa nuova.</div><div class=\"mistake\"><strong>Errato: libri nuova.</strong>Corretto: libri nuovi.</div><div class=\"mistake\"><strong>Errato: una lezione interessanta.</strong>Corretto: una lezione interessante.</div><div class=\"mistake\"><strong>Errato: due studenti gentile.</strong>Corretto: due studenti gentili.</div></div>\n    </article>\n\n    <article class=\"lesson-box\" id=\"esercizi\">\n      <h2>Exercises with immediate feedback</h2>\n      <p>Write the correct form of the adjective.</p>\n      <div class=\"exercise\" data-answer=\"nuova\" data-hint=\"Home is feminine singular: new.\"><label>1. una casa ___ (nuovo)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"nuovi\" data-hint=\"Books are masculine plural: new.\"><label>2. due libri ___ (nuovo)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"interessante\" data-hint=\"Adjectives ending in -e are equal to the singular.\"><label>3. una lezione ___ (interessante)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"interessanti\" data-hint=\"In the plural, adjectives ending in -e become -i.\"><label>4. due lezioni ___ (interessante)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"italiana\" data-hint=\"Ragazza is feminine singular: Italian.\"><label>5. una ragazza ___ (italiano)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"italiani\" data-hint=\"Students are masculine plural: Italians.\"><label>6. studenti ___ (italiano)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"facile\" data-hint=\"Exercise is singular: easy.\"><label>7. un esercizio ___ (facile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"facili\" data-hint=\"Exercises is plural: easy.\"><label>8. esercizi ___ (facile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"gentile\" data-hint=\"Person is singular: kind.\"><label>9. una persona ___ (gentile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"gentili\" data-hint=\"People is plural: kind.\"><label>10. persone ___ (gentile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"score-card\"><div><strong>Your result</strong><p id=\"score-text\">0 correct answers out of 10</p></div><strong id=\"score-percent\">0%</strong></div>\n      <div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">Start again</button><a class=\"button primary\" href=\"../\">Return to the route</a></div>\n    </article>\n  </div></section>\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>Choose who to learn Italian with</h2></div><p>Two teachers, two perspectives. Choose the approach that best matches your interests.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Science, technology and etymology</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Learn with Martin</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Art, patience and grammar</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Learn with Licia</a></article></div><div class=\"teacher-cta-links\"><a href=\"/en/about-us/\">Meet Martin and Licia</a><a href=\"https://wa.me/59167434075?text=Hello%2C%20I%20would%20like%20information%20about%20Italian%20lessons%20with%20Martin%20or%20Licia.\" target=\"_blank\" rel=\"noopener\">Message us on WhatsApp</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Clear grammar, graded readings and online lessons.</p></div><div><a href=\"/en/grammar/\">Grammar</a><a href=\"/en/readings/\">Readings</a><a href=\"/en/vocabulary/\">Vocabulary</a><a class=\"about-link\" href=\"/en/about-us/\">About us</a></div></div></footer>\n<script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n\n</body></html>";
