const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: es/gramatica/a2/el-passato-prossimo-italiano.html -->\n<html lang=\"es\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/grammatica/a2/passato-prossimo.html\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/grammar/a2/the-passato-prossimo-tense.html\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/gramatica/a2/el-passato-prossimo-italiano.html\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/grammaire/a2/le-passato-prossimo-italien.html\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/gramatika/a2/italsky-passato-prossimo.html\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/gramatyka/a2/wloski-passato-prossimo.html\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/dilbilgisi/a2/italyanca-passato-prossimo.html\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/grammatik/a2/das-italienische-passato-prossimo.html\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/bunpo/a2/イタリア語の-passato-prossimo.html\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/grammatica/a2/passato-prossimo.html\"><link rel=\"canonical\" href=\"https://italianoconmartin.com/es/gramatica/a2/el-passato-prossimo-italiano.html\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>El passato prossimo italiano | gramática italiana A2 | Italiano con Martin</title>\n  <meta name=\"description\" content=\"Aprende el presente perfecto en italiano con to be y to have, participios pasados, ejemplos y ejercicios interactivos.\">\n\n\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n  <meta name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"El passato prossimo italiano | gramática italiana A2 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"Aprende el presente perfecto en italiano con to be y to have, participios pasados, ejemplos y ejercicios interactivos.\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/es/gramatica/a2/el-passato-prossimo-italiano.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"El passato prossimo italiano | gramática italiana A2 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"Aprende el presente perfecto en italiano con to be y to have, participios pasados, ejemplos y ejercicios interactivos.\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n<link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"El passato prossimo italiano\",\"url\":\"https://italianoconmartin.com/es/gramatica/a2/el-passato-prossimo-italiano.html\",\"inLanguage\":\"es\"}</script></head>\n<body data-lesson=\"martin-passato-prossimo-a2\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/es/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇪🇸</span><span class=\"language-current\">Español</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/a2/passato-prossimo.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/a2/the-passato-prossimo-tense.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/a2/el-passato-prossimo-italiano.html\" hreflang=\"es\" lang=\"es\" aria-current=\"page\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/a2/le-passato-prossimo-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/a2/italsky-passato-prossimo.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/a2/wloski-passato-prossimo.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/a2/italyanca-passato-prossimo.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/a2/das-italienische-passato-prossimo.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/a2/イタリア語の-passato-prossimo.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/es/gramatica/\">Gramática</a><a href=\"/es/lecturas/\">Lecturas</a><a href=\"/es/vocabulario/\">Vocabulario</a><a class=\"about-link\" href=\"/es/sobre-nosotros/\">Quiénes somos</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Reserva en Preply</a></nav></div></header>\n<main>\n  <section class=\"page-intro\"><div class=\"container lesson-shell\"><p class=\"breadcrumbs\"><a href=\"/es/\">Inicio</a> / <a href=\"/es/gramatica/\">Gramática</a> / A2 / El passato prossimo italiano</p><p class=\"eyebrow\">Gramática A2</p><h1>El passato prossimo italiano</h1><p class=\"lead\">Aprende a hablar de acciones terminadas: ayer estudié, fui, comimos.</p><div class=\"lesson-meta\"><span>15 minutos</span><span>12 ejercicios</span><span>Nivel A2</span></div><div class=\"lesson-nav\"><a href=\"#forma\">Formulario</a><a href=\"#ausiliare\">ser o tener</a><a href=\"#errori\">Errores</a><a href=\"#esercizi\">Ejercicios</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/es/el-passato-prossimo-italiano-a2.pdf\" download=\"\">PDF A2</a></div></div></section>\n  <section class=\"section compact-top\"><div class=\"container lesson-shell\">\n    <article class=\"lesson-box\" id=\"forma\">\n      <h2>¿Cómo se forma?</h2>\n      <p>El presente perfecto se forma con <strong>tener</strong> o <strong>ser</strong> en presente + participio pasado.</p>\n      <table class=\"conj-table\"><thead><tr><th>Verbo</th><th>Participio</th><th>Esempio</th></tr></thead><tbody><tr><td>parlare</td><td>parlato</td><td>Ho parlato con Maria.</td></tr><tr><td>credere</td><td>creduto</td><td>Abbiamo creduto alla storia.</td></tr><tr><td>dormire</td><td>dormito</td><td>Hai dormito bene?</td></tr><tr><td>andare</td><td>andato</td><td>Sono andato a Roma.</td></tr></tbody></table>\n      <p class=\"mini-note\"><strong>Fórmula:</strong> Tengo/tú tienes/tiene/nosotros/tú tienes/tenemos + participio o soy/tú eres/es/somos/tú eres/soy + participio.</p>\n    </article>\n\n    <article class=\"lesson-box\" id=\"ausiliare\">\n      <h2>¿Ser o tener?</h2>\n      <div class=\"rule-grid\"><div class=\"rule-card\"><strong>tener</strong><br>Muchos verbos usan: comí, estudié, vi.</div><div class=\"rule-card\"><strong>ser</strong><br>Movimiento o cambio: fui, llegué, nací.</div><div class=\"rule-card\"><strong>Con ser el final cambia</strong><br>Marco se ha ido. Anna se ha ido.</div><div class=\"rule-card\"><strong>Plural</strong><br>Marco y Luca se han ido. Anna y Sara se han ido.</div></div>\n    </article>\n\n    <article class=\"lesson-box\" id=\"errori\">\n      <h2>Errores que casi todo el mundo comete</h2>\n      <div class=\"mistake-grid\"><div class=\"mistake\"><strong>Errato: io sono mangiato.</strong>Corretto: io ho mangiato.</div><div class=\"mistake\"><strong>Errato: lei ha andato.</strong>Corretto: lei è andata.</div><div class=\"mistake\"><strong>Errato: noi abbiamo arrivato.</strong>Corretto: noi siamo arrivati.</div><div class=\"mistake\"><strong>Errato: Anna è andato.</strong>Corretto: Anna è andata.</div></div>\n    </article>\n\n    <article class=\"lesson-box\" id=\"esercizi\">\n      <h2>Ejercicios con retroalimentación inmediata.</h2>\n      <p>Escribe la forma correcta del presente perfecto.</p>\n      <div class=\"exercise\" data-answer=\"ho mangiato\" data-hint=\"Comer utiliza tener: comí.\"><label>1. Io ___ una pizza. (mangiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"sei andato\" data-alt=\"sei andata\" data-hint=\"Ir suele ser: fuiste/fuiste.\"><label>2. Tu ___ al lavoro. (andare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"ha studiato\" data-hint=\"Estudiar utiliza tener: estudió.\"><label>3. Lei ___ italiano. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"siamo arrivati\" data-alt=\"siamo arrivate\" data-hint=\"Llegar usa ser y está de acuerdo con el tema.\"><label>4. Noi ___ tardi. (arrivare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"avete visto\" data-hint=\"Ver usos tener: has visto.\"><label>5. Voi ___ il film. (vedere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"sono partiti\" data-alt=\"sono partite\" data-hint=\"Dejar usa el ser y está de acuerdo con el sujeto.\"><label>6. Loro ___ ieri. (partire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"ho dormito\" data-hint=\"Dormir usa tener: dormí.\"><label>7. Io ___ otto ore. (dormire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"è nata\" data-alt=\"è nata|e' nata\" data-hint=\"Nacer suele ser; María es femenina: ella nació.\"><label>8. Maria ___ a Milano. (nascere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"abbiamo parlato\" data-hint=\"Hablar usa tener: hablamos.\"><label>9. Noi ___ con Martin. (parlare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"sono tornato\" data-alt=\"sono tornata\" data-hint=\"La devolución utiliza el ser y está de acuerdo con el tema.\"><label>10. Io ___ a casa. (tornare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"hai letto\" data-hint=\"Los usos leídos tienen: has leído.\"><label>11. Tu ___ questo libro? (leggere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"sono usciti\" data-alt=\"sono uscite\" data-hint=\"Salir utiliza el ser y concuerda con el sujeto.\"><label>12. I ragazzi ___ alle otto. (uscire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"score-card\"><div><strong>tu resultado</strong><p id=\"score-text\">0 respuestas correctas de 12</p></div><strong id=\"score-percent\">0%</strong></div>\n      <div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">empezar de nuevo</button><a class=\"button primary\" href=\"../\">volver a la gramática</a></div>\n    </article>\n  </div></section>\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>Elige con quién aprender italiano</h2></div><p>Dos profesores, dos perspectivas. Elige el enfoque que mejor se adapte a tus intereses.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Ciencia, tecnología y etimología</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Aprende con Martin</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Arte, paciencia y gramática</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Aprende con Licia</a></article></div><div class=\"teacher-cta-links\"><a href=\"/es/sobre-nosotros/\">Conoce a Martin y Licia</a><a href=\"https://wa.me/59167434075?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20las%20clases%20de%20italiano%20con%20Martin%20o%20Licia.\" target=\"_blank\" rel=\"noopener\">Escríbenos por WhatsApp</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Gramática clara, lecturas calificadas y lecciones en línea.</p></div><div><a href=\"/es/gramatica/\">Gramática</a><a href=\"/es/lecturas/\">Lecturas</a><a href=\"/es/vocabulario/\">Vocabulario</a><a class=\"about-link\" href=\"/es/sobre-nosotros/\">Quiénes somos</a></div></div></footer>\n<script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n\n</body></html>";
