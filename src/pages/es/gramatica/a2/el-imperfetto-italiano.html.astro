const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: es/gramatica/a2/el-imperfetto-italiano.html -->\n<html lang=\"es\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/grammatica/a2/imperfetto.html\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/grammar/a2/the-imperfetto-tense.html\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/gramatica/a2/el-imperfetto-italiano.html\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/grammaire/a2/limperfetto-italien.html\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/gramatika/a2/italsky-imperfetto.html\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/gramatyka/a2/wloski-imperfetto.html\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/dilbilgisi/a2/italyanca-imperfetto.html\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/grammatik/a2/das-italienische-imperfetto.html\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/bunpo/a2/イタリア語の-imperfetto.html\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/grammatica/a2/imperfetto.html\"><link rel=\"canonical\" href=\"https://italianoconmartin.com/es/gramatica/a2/el-imperfetto-italiano.html\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>El imperfetto italiano | gramática italiana A2 | Italiano con Martin</title>\n  <meta name=\"description\" content=\"Aprende el imperfecto italiano con usos, conjugaciones, ejemplos cotidianos, errores comunes y ejercicios interactivos.\">\n\n\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n  <meta name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"El imperfetto italiano | gramática italiana A2 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"Aprende el imperfecto italiano con usos, conjugaciones, ejemplos cotidianos, errores comunes y ejercicios interactivos.\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/es/gramatica/a2/el-imperfetto-italiano.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"El imperfetto italiano | gramática italiana A2 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"Aprende el imperfecto italiano con usos, conjugaciones, ejemplos cotidianos, errores comunes y ejercicios interactivos.\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n<link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"El imperfetto italiano\",\"url\":\"https://italianoconmartin.com/es/gramatica/a2/el-imperfetto-italiano.html\",\"inLanguage\":\"es\"}</script></head>\n<body data-lesson=\"martin-imperfetto-a2\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/es/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇪🇸</span><span class=\"language-current\">Español</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/a2/imperfetto.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/a2/the-imperfetto-tense.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/a2/el-imperfetto-italiano.html\" hreflang=\"es\" lang=\"es\" aria-current=\"page\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/a2/limperfetto-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/a2/italsky-imperfetto.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/a2/wloski-imperfetto.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/a2/italyanca-imperfetto.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/a2/das-italienische-imperfetto.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/a2/イタリア語の-imperfetto.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/es/gramatica/\">Gramática</a><a href=\"/es/lecturas/\">Lecturas</a><a href=\"/es/vocabulario/\">Vocabulario</a><a class=\"about-link\" href=\"/es/sobre-nosotros/\">Quiénes somos</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Reserva en Preply</a></nav></div></header>\n<main>\n  <section class=\"page-intro\">\n    <div class=\"container lesson-shell\">\n      <p class=\"breadcrumbs\"><a href=\"/es/\">Inicio</a> / <a href=\"/es/gramatica/\">Gramática</a> / A2 / El imperfetto italiano</p>\n      <p class=\"eyebrow\">Gramática A2</p>\n      <h1>El imperfetto italiano</h1>\n      <p class=\"lead\">Aprenda a hablar sobre hábitos del pasado, descripciones y situaciones actuales.</p>\n      <div class=\"lesson-meta\"><span>14 minutos</span><span>12 ejercicios</span><span>Nivel A2</span></div>\n      <div class=\"lesson-nav\"><a href=\"#uso\">Uso</a><a href=\"#forme\">formas</a><a href=\"#errori\">Errores</a><a href=\"#esercizi\">Ejercicios</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/es/el-imperfetto-italiano-a2.pdf\" download=\"\">PDF A2</a></div>\n    </div>\n  </section>\n\n  <section class=\"section compact-top\">\n    <div class=\"container lesson-shell\">\n      <article class=\"lesson-box\" id=\"uso\">\n        <h2>¿Cuándo usamos el imperfecto?</h2>\n        <div class=\"rule-grid\">\n          <div class=\"rule-card\"><strong>Hábitos en el pasado</strong><br>Cuando era niño jugaba en el jardín.</div>\n          <div class=\"rule-card\"><strong>Descripciones</strong><br>La casa era pequeña pero luminosa.</div>\n          <div class=\"rule-card\"><strong>Acciones en curso</strong><br>Mientras estudiaba, Marco llamó.</div>\n          <div class=\"rule-card\"><strong>Edad, tiempo, tiempo</strong><br>Yo tenía diez años. Eran las ocho. Estaba lloviendo.</div>\n        </div>\n        <p class=\"italian-box\"><strong>¿Cómo habla realmente un italiano?</strong><br>Para contar tu vida, lo imperfecto es imprescindible: <strong>Cuando vivía en Argentina, hablaba frecuentemente italiano con mi abuela.</strong></p>\n      </article>\n\n      <article class=\"lesson-box\" id=\"forme\">\n        <h2>Formas regulares</h2>\n        <table class=\"conj-table\">\n          <thead><tr><th>Persona</th><th>parlare</th><th>credere</th><th>dormire</th></tr></thead>\n          <tbody>\n            <tr><td>io</td><td>parlavo</td><td>credevo</td><td>dormivo</td></tr>\n            <tr><td>tu</td><td>parlavi</td><td>credevi</td><td>dormivi</td></tr>\n            <tr><td>lui / lei</td><td>parlava</td><td>credeva</td><td>dormiva</td></tr>\n            <tr><td>noi</td><td>parlavamo</td><td>credevamo</td><td>dormivamo</td></tr>\n            <tr><td>voi</td><td>parlavate</td><td>credevate</td><td>dormivate</td></tr>\n            <tr><td>loro</td><td>parlavano</td><td>credevano</td><td>dormivano</td></tr>\n          </tbody>\n        </table>\n        <h3>Tres verbos muy importantes</h3>\n        <div class=\"example-grid\">\n          <div class=\"example\"><strong>essere</strong><br>ero, eri, era, eravamo, eravate, erano</div>\n          <div class=\"example\"><strong>avere</strong><br>avevo, avevi, aveva, avevamo, avevate, avevano</div>\n          <div class=\"example\"><strong>fare</strong><br>facevo, facevi, faceva, facevamo, facevate, facevano</div>\n          <div class=\"example\"><strong>dire</strong><br>dicevo, dicevi, diceva, dicevamo, dicevate, dicevano</div>\n        </div>\n      </article>\n\n      <article class=\"lesson-box\" id=\"errori\">\n        <h2>Errores que casi todo el mundo comete</h2>\n        <div class=\"mistake-grid\">\n          <div class=\"mistake\"><strong>Errato: io era stanco.</strong>Corretto: io ero stanco.</div>\n          <div class=\"mistake\"><strong>Errato: noi parlava.</strong>Corretto: noi parlavamo.</div>\n          <div class=\"mistake\"><strong>Errato: quando ero bambino, sono giocato.</strong>Corretto: quando ero bambino, giocavo.</div>\n          <div class=\"mistake\"><strong>Errato: facevo una pizza ieri.</strong>Meglio: ieri ho fatto una pizza.</div>\n        </div>\n      </article>\n\n      <article class=\"lesson-box\" id=\"esercizi\">\n        <h2>Ejercicios con retroalimentación inmediata.</h2>\n        <p>Escribe la forma correcta del imperfecto.</p>\n        <div class=\"exercise\" data-answer=\"parlavo\" data-hint=\"Conmigo: estaba hablando.\"><label>1. Da bambino io ___ poco. (parlare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"vivevi\" data-hint=\"Contigo: viviste.\"><label>2. Tu ___ in Italia? (vivere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"era\" data-hint=\"Con él/ella: fue.\"><label>3. La casa ___ grande. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"avevamo\" data-hint=\"Con nosotros: teníamos.\"><label>4. Noi ___ molto tempo. (avere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"dormivate\" data-hint=\"Contigo: estabas durmiendo.\"><label>5. Voi ___ fino a tardi. (dormire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"andavano\" data-hint=\"Con ellos: se fueron.\"><label>6. Loro ___ a scuola a piedi. (andare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"facevo\" data-hint=\"Hacer en lo imperfecto: lo hice.\"><label>7. Io ___ colazione alle otto. (fare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"diceva\" data-hint=\"Decir en imperfecto: dijo.\"><label>8. Marco ___ sempre la verità. (dire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"pioveva\" data-hint=\"En cuanto al tiempo: estaba lloviendo.\"><label>9. Ieri mattina ___ molto. (piovere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"studiavo\" data-hint=\"Acción en curso: estaba estudiando.\"><label>10. Mentre ___, ha telefonato Anna. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"erano\" data-hint=\"Con las ocho: estaban.\"><label>11. ___ le otto quando sono uscito. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"leggevano\" data-hint=\"Con ellos: leen.\"><label>12. I bambini ___ una storia. (leggere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"score-card\"><div><strong>tu resultado</strong><p id=\"score-text\">0 respuestas correctas de 12</p></div><strong id=\"score-percent\">0%</strong></div>\n        <div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">empezar de nuevo</button><a class=\"button primary\" href=\"../\">volver a la gramática</a></div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>Elige con quién aprender italiano</h2></div><p>Dos profesores, dos perspectivas. Elige el enfoque que mejor se adapte a tus intereses.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Ciencia, tecnología y etimología</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Aprende con Martin</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Arte, paciencia y gramática</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Aprende con Licia</a></article></div><div class=\"teacher-cta-links\"><a href=\"/es/sobre-nosotros/\">Conoce a Martin y Licia</a><a href=\"https://wa.me/59167434075?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20las%20clases%20de%20italiano%20con%20Martin%20o%20Licia.\" target=\"_blank\" rel=\"noopener\">Escríbenos por WhatsApp</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Gramática clara, lecturas calificadas y lecciones en línea.</p></div><div><a href=\"/es/gramatica/\">Gramática</a><a href=\"/es/lecturas/\">Lecturas</a><a href=\"/es/vocabulario/\">Vocabulario</a><a class=\"about-link\" href=\"/es/sobre-nosotros/\">Quiénes somos</a></div></div></footer>\n<script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n\n</body></html>";
