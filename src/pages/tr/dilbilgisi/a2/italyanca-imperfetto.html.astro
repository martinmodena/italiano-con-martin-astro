nt=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"İtalyanca imperfetto zamanı | İtalyanca dil bilgisi A2 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"Kullanımları, çekimleri, günlük örnekleri, yaygın hataları ve etkileşimli alıştırmalarla İtalyanca kusurlu kelimeleri öğrenin.\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/tr/dilbilgisi/a2/italyanca-imperfetto.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"İtalyanca imperfetto zamanı | İtalyanca dil bilgisi A2 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"Kullanımları, çekimleri, günlük örnekleri, yaygın hataları ve etkileşimli alıştırmalarla İtalyanca kusurlu kelimeleri öğrenin.\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n<link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"İtalyanca imperfetto zamanı\",\"url\":\"https://italianoconmartin.com/tr/dilbilgisi/a2/italyanca-imperfetto.html\",\"inLanguage\":\"tr\"}</script></head>\n<body data-lesson=\"martin-imperfetto-a2\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/tr/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇹🇷</span><span class=\"language-current\">Türkçe</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/a2/imperfetto.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/a2/the-imperfetto-tense.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/a2/el-imperfetto-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/a2/limperfetto-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/a2/italsky-imperfetto.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/a2/wloski-imperfetto.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/a2/italyanca-imperfetto.html\" hreflang=\"tr\" lang=\"tr\" aria-current=\"page\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/a2/das-italienische-imperfetto.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/a2/イタリア語の-imperfetto.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/tr/dilbilgisi/\">Dilbilgisi</a><a href=\"/tr/okumalar/\">Okumalar</a><a href=\"/tr/kelime-bilgisi/\">Kelime Bilgisi</a><a class=\"about-link\" href=\"/tr/hakkimizda/\">Hakkımızda</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Preply'da rezervasyon yaptırın</a></nav></div></header>\n<main>\n  <section class=\"page-intro\">\n    <div class=\"container lesson-shell\">\n      <p class=\"breadcrumbs\"><a href=\"/tr/\">Ana sayfa</a> / <a href=\"/tr/dilbilgisi/\">Dilbilgisi</a> / A2 / İtalyanca imperfetto zamanı</p>\n      <p class=\"eyebrow\">Dilbilgisi A2</p>\n      <h1>İtalyanca imperfetto zamanı</h1>\n      <p class=\"lead\">Geçmişteki alışkanlıklar, açıklamalar ve güncel durumlar hakkında konuşmayı öğrenin.</p>\n      <div class=\"lesson-meta\"><span>14 dakika</span><span>12 egzersiz</span><span>A2 Düzeyi</span></div>\n      <div class=\"lesson-nav\"><a href=\"#uso\">Kullanım</a><a href=\"#forme\">Şekiller</a><a href=\"#errori\">Hatalar</a><a href=\"#esercizi\">Egzersizler</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/tr/italyanca-imperfetto-a2.pdf\" download=\"\">PDF A2</a></div>\n    </div>\n  </section>\n\n  <section class=\"section compact-top\">\n    <div class=\"container lesson-shell\">\n      <article class=\"lesson-box\" id=\"uso\">\n        <h2>Kusurlu olanı ne zaman kullanırız?</h2>\n        <div class=\"rule-grid\">\n          <div class=\"rule-card\"><strong>Geçmişteki alışkanlıklar</strong><br>Çocukken bahçede oynardım.</div>\n          <div class=\"rule-card\"><strong>Açıklamalar</strong><br>Ev küçük ama aydınlıktı.</div>\n          <div class=\"rule-card\"><strong>Devam eden eylemler</strong><br>Ben ders çalışırken Marco aradı.</div>\n          <div class=\"rule-card\"><strong>Yaş, zaman, zaman</strong><br>On yaşındaydım. Saat sekizdi. Yağmur yağıyordu.</div>\n        </div>\n        <p class=\"italian-box\"><strong>Bir İtalyan gerçekte nasıl konuşur?</strong><br>Hayatınızı anlatmak için kusurlu olan önemlidir: <strong>Arjantin'de yaşarken büyükannemle sık sık İtalyanca konuşurdum.</strong></p>\n      </article>\n\n      <article class=\"lesson-box\" id=\"forme\">\n        <h2>Düzenli şekiller</h2>\n        <table class=\"conj-table\">\n          <thead><tr><th>Persona</th><th>parlare</th><th>credere</th><th>dormire</th></tr></thead>\n          <tbody>\n            <tr><td>io</td><td>parlavo</td><td>credevo</td><td>dormivo</td></tr>\n            <tr><td>tu</td><td>parlavi</td><td>credevi</td><td>dormivi</td></tr>\n            <tr><td>lui / lei</td><td>parlava</td><td>credeva</td><td>dormiva</td></tr>\n            <tr><td>noi</td><td>parlavamo</td><td>credevamo</td><td>dormivamo</td></tr>\n            <tr><td>voi</td><td>parlavate</td><td>credevate</td><td>dormivate</td></tr>\n            <tr><td>loro</td><td>parlavano</td><td>credevano</td><td>dormivano</td></tr>\n          </tbody>\n        </table>\n        <h3>Üç çok önemli fiil</h3>\n        <div class=\"example-grid\">\n          <div class=\"example\"><strong>essere</strong><br>ero, eri, era, eravamo, eravate, erano</div>\n          <div class=\"example\"><strong>avere</strong><br>avevo, avevi, aveva, avevamo, avevate, avevano</div>\n          <div class=\"example\"><strong>fare</strong><br>facevo, facevi, faceva, facevamo, facevate, facevano</div>\n          <div class=\"example\"><strong>dire</strong><br>dicevo, dicevi, diceva, dicevamo, dicevate, dicevano</div>\n        </div>\n      </article>\n\n      <article class=\"lesson-box\" id=\"errori\">\n        <h2>Hemen hemen herkesin yaptığı hatalar</h2>\n        <div class=\"mistake-grid\">\n          <div class=\"mistake\"><strong>Errato: io era stanco.</strong>Corretto: io ero stanco.</div>\n          <div class=\"mistake\"><strong>Errato: noi parlava.</strong>Corretto: noi parlavamo.</div>\n          <div class=\"mistake\"><strong>Errato: quando ero bambino, sono giocato.</strong>Corretto: quando ero bambino, giocavo.</div>\n          <div class=\"mistake\"><strong>Errato: facevo una pizza ieri.</strong>Meglio: ieri ho fatto una pizza.</div>\n        </div>\n      </article>\n\n      <article class=\"lesson-box\" id=\"esercizi\">\n        <h2>Anında geri bildirim sağlayan egzersizler</h2>\n        <p>Kusurlu olanın doğru biçimini yazın.</p>\n        <div class=\"exercise\" data-answer=\"parlavo\" data-hint=\"Benimle: Konuşuyordum.\"><label>1. Da bambino io ___ poco. (parlare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"vivevi\" data-hint=\"Seninle: yaşadın.\"><label>2. Tu ___ in Italia? (vivere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"era\" data-hint=\"Onunla: öyleydi.\"><label>3. La casa ___ grande. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"avevamo\" data-hint=\"Bizimle: vardı.\"><label>4. Noi ___ molto tempo. (avere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"dormivate\" data-hint=\"Seninle: uyuyordun.\"><label>5. Voi ___ fino a tardi. (dormire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"andavano\" data-hint=\"Onlarla birlikte: gittiler.\"><label>6. Loro ___ a scuola a piedi. (andare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"facevo\" data-hint=\"Kusurlu olanı yapın: Yaptım.\"><label>7. Io ___ colazione alle otto. (fare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"diceva\" data-hint=\"Kusurlu bir şekilde söylemek: dedi.\"><label>8. Marco ___ sempre la verità. (dire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"pioveva\" data-hint=\"Hava durumu için: yağmur yağıyordu.\"><label>9. Ieri mattina ___ molto. (piovere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"studiavo\" data-hint=\"Eylem devam ediyor: Çalışıyordum.\"><label>10. Mentre ___, ha telefonato Anna. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"erano\" data-hint=\"Saat sekizde: öyleydi.\"><label>11. ___ le otto quando sono uscito. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"leggevano\" data-hint=\"Onlarla birlikte: okurlar.\"><label>12. I bambini ___ una storia. (leggere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"score-card\"><div><strong>Sonucunuz</strong><p id=\"score-text\">12 üzerinden 0 doğru cevap</p></div><strong id=\"score-percent\">0%</strong></div>\n        <div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">Tekrar başla</button><a class=\"button primary\" href=\"../\">Dilbilgisine geri dön</a></div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>İtalyancayı kiminle öğreneceğinizi seçin</h2></div><p>İki öğretmen, iki yaklaşım. İlgi alanlarınıza en uygun olanı seçin.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Bilim, teknoloji ve etimoloji</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Martin ile öğren</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Sanat, sabır ve dil bilgisi</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Licia ile öğren</a></article></div><div class=\"teacher-cta-links\"><a href=\"/tr/hakkimizda/\">Martin ve Licia’yı tanıyın</a><a href=\"https://wa.me/59167434075?text=Merhaba%2C%20Martin%20veya%20Licia%20ile%20%C4%B0talyanca%20dersleri%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum.\" target=\"_blank\" rel=\"noopener\">WhatsApp’tan yazın</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Net dilbilgisi, dereceli okumalar ve çevrimiçi dersler.</p></div><div><a href=\"/tr/dilbilgisi/\">Dilbilgisi</a><a href=\"/tr/okumalar/\">Okumalar</a><a href=\"/tr/kelime-bilgisi/\">Kelime Bilgisi</a><a class=\"about-link\" href=\"/tr/hakkimizda/\">Hakkımızda</a></div></div></footer>\n<script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n\n</body></html>";
