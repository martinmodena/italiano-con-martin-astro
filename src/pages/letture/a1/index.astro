---
// Indice per livello (decisione 2026-09-29): le letture che hanno un A1 valido.
import SiteLayout from '~/layouts/SiteLayout.astro';
import main from '~/html/letture/a1/index.html?raw';
const site = 'https://italianoconmartin.com';
const items = [
  ['Al bar in Italia', '/letture/storia-del-caffe-in-italia.html#a1'],
  ['La formichina Wow', '/favole/la-formichina-wow.html#a1'],
  ['La cicala e la formica', '/favole/la-cicala-e-la-formica.html#a1'],
  ["Il mugnaio, suo figlio e l'asino", '/favole/il-mugnaio-suo-figlio-e-lasino.html#a1'],
  ['La lepre e la tartaruga', '/favole/la-lepre-e-la-tartaruga.html#a1'],
  ['Il lupo e i tre porcellini', '/favole/il-lupo-e-i-tre-porcellini.html#a1'],
  ['Il topo di città e il topo di campagna', '/favole/il-topo-di-citta-e-il-topo-di-campagna.html#a1'],
  ["Il cane e l'osso", '/favole/il-cane-e-losso.html#a1'],
  ["La volpe e l'uva", '/favole/la-volpe-e-luva.html#a1'],
  ['Il pastorello bugiardo', '/favole/il-pastorello-bugiardo.html#a1'],
  ['Il leone e il topo', '/favole/il-leone-e-il-topo.html#a1'],
  ["I vestiti nuovi dell'imperatore", '/favole/i-vestiti-nuovi-dellimperatore.html#a1'],
];
const title = 'Letture in italiano A1: racconti brevi per principianti (PDF)';
const description =
  'Racconti e favole in italiano per principianti (livello A1): frasi corte, parole di tutti i giorni, domande di comprensione e PDF gratis. Leggi e impara la grammatica in contesto.';
const url = `${site}/letture/a1/`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url,
  inLanguage: 'it',
  educationalLevel: 'A1',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: items.map(([name, path], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name,
      url: site + path,
    })),
  },
});
const meta = {
  path: 'letture/a1/index.html',
  lang: 'it',
  title,
  description,
  canonical: url,
  robots: 'index,follow,max-image-preview:large',
  author: 'Martin Modena',
  og: [
    ['og:type', 'website'],
    ['og:site_name', 'Italiano con Martin'],
    ['og:title', title],
    ['og:description', 'Racconti brevi in italiano per il livello A1, con domande e PDF gratis.'],
    ['og:url', url],
    ['og:image', `${site}/assets/story-formica-wow.webp`],
    ['twitter:card', 'summary_large_image'],
    ['twitter:title', title],
    ['twitter:description', 'Racconti brevi in italiano per il livello A1, con domande e PDF gratis.'],
    ['twitter:image', `${site}/assets/story-formica-wow.webp`],
  ],
  jsonld: [jsonld],
  hreflangs: [["it","https://italianoconmartin.com/letture/a1/"],["en","https://italianoconmartin.com/en/readings/a1/"],["es","https://italianoconmartin.com/es/lecturas/a1/"],["fr","https://italianoconmartin.com/fr/lectures/a1/"],["cs","https://italianoconmartin.com/cs/cteni/a1/"],["pl","https://italianoconmartin.com/pl/czytanki/a1/"],["tr","https://italianoconmartin.com/tr/okumalar/a1/"],["de","https://italianoconmartin.com/de/lesetexte/a1/"],["ja","https://italianoconmartin.com/ja/dokkai/a1/"],["x-default","https://italianoconmartin.com/letture/a1/"]],
  extraHead: [],
  assetPrefix: '../../',
  brandHref: '../../',
  bodyScripts: ['<script src="../../script.js"></script>'],
  iconLinks: [
    '<link rel="icon" href="../../favicon.png" type="image/png">',
    '<link rel="apple-touch-icon" href="../../apple-touch-icon.png">',
  ],
  brandImgSrc: '../../assets/martin-photo.svg',
  optionsHtml: "<a href=\"/letture/a1/\" hreflang=\"it\" lang=\"it\" aria-current=\"page\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/readings/a1/\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/lecturas/a1/\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/lectures/a1/\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/cteni/a1/\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/czytanki/a1/\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/okumalar/a1/\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/lesetexte/a1/\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/dokkai/a1/\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a>",
  ui: {
    nav: '<a href="/grammatica/">Grammatica</a><a href="/letture/">Letture</a><a href="/vocabolario/">Vocabolario</a><a class="about-link" href="/chi-siamo/">Chi siamo</a>',
    footerGrid:
      '<div><strong>Italiano con Martin</strong><p>Letture graduate, grammatica chiara e lezioni online.</p></div><div><a href="/grammatica/">Grammatica</a><a href="/letture/">Letture</a><a href="/vocabolario/">Vocabolario</a><a class="about-link" href="/chi-siamo/">Chi siamo</a></div>',
  },
};
---

<SiteLayout meta={meta} main={main} />
