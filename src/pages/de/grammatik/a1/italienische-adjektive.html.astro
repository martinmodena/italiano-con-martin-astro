const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: de/grammatik/a1/italienische-adjektive.html -->\n<html lang=\"de\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/grammatica/a1/aggettivi-qualificativi.html\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/grammar/a1/italian-qualifying-adjectives.html\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/gramatica/a1/adjetivos-calificativos-en-italiano.html\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/grammaire/a1/adjectifs-qualificatifs-en-italien.html\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/gramatika/a1/italska-pridavna-jmena.html\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/gramatyka/a1/wloskie-przymiotniki-kwalifikujace.html\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/dilbilgisi/a1/italyanca-niteleme-sifatlari.html\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/grammatik/a1/italienische-adjektive.html\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/bunpo/a1/イタリア語の形容詞.html\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/grammatica/a1/aggettivi-qualificativi.html\"><link rel=\"canonical\" href=\"https://italianoconmartin.com/de/grammatik/a1/italienische-adjektive.html\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Italienische Adjektive | italienische Grammatik A1 | Italiano con Martin</title>\n  <meta name=\"description\" content=\"Lernen Sie qualifizierende Adjektive auf Italienisch: Übereinstimmung mit Geschlecht und Numerus, Position, Beispiele und interaktive Übungen.\">\n\n\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n  <meta name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"Italienische Adjektive | italienische Grammatik A1 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"Lernen Sie qualifizierende Adjektive auf Italienisch: Übereinstimmung mit Geschlecht und Numerus, Position, Beispiele und interaktive Übungen.\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/de/grammatik/a1/italienische-adjektive.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"Italienische Adjektive | italienische Grammatik A1 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"Lernen Sie qualifizierende Adjektive auf Italienisch: Übereinstimmung mit Geschlecht und Numerus, Position, Beispiele und interaktive Übungen.\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n<link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"Italienische Adjektive\",\"url\":\"https://italianoconmartin.com/de/grammatik/a1/italienische-adjektive.html\",\"inLanguage\":\"de\"}</script></head>\n<body data-lesson=\"martin-aggettivi-a1\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/de/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇩🇪</span><span class=\"language-current\">Deutsch</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/a1/aggettivi-qualificativi.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/a1/italian-qualifying-adjectives.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/a1/adjetivos-calificativos-en-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/a1/adjectifs-qualificatifs-en-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/a1/italska-pridavna-jmena.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/a1/wloskie-przymiotniki-kwalifikujace.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/a1/italyanca-niteleme-sifatlari.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/a1/italienische-adjektive.html\" hreflang=\"de\" lang=\"de\" aria-current=\"page\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/a1/イタリア語の形容詞.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/de/grammatik/\">Grammatik</a><a href=\"/de/lesetexte/\">Lesungen</a><a href=\"/de/wortschatz/\">Wortschatz</a><a class=\"about-link\" href=\"/de/ueber-uns/\">Über uns</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Buchen Sie auf Preply</a></nav></div></header>\n<main>\n  <section class=\"page-intro\"><div class=\"container lesson-shell\"><p class=\"breadcrumbs\"><a href=\"/de/\">Zuhause</a> / <a href=\"/de/grammatik/\">Grammatik</a> / A1 / Italienische Adjektive</p><p class=\"eyebrow\">Grammatik A1</p><h1>Italienische Adjektive</h1><p class=\"lead\">Lernen Sie, Menschen, Gegenstände und Orte zu beschreiben: schön, groß, interessant, italienisch.</p><div class=\"lesson-meta\"><span>10 Minuten</span><span>10 Übungen</span><span>Niveau A1</span></div><div class=\"lesson-nav\"><a href=\"#accordo\">Vereinbarung</a><a href=\"#posizione\">Standort</a><a href=\"#errori\">Fehler</a><a href=\"#esercizi\">Übungen</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/de/italienische-adjektive-a1.pdf\" download=\"\">PDF A1</a></div></div></section>\n  <section class=\"section compact-top\"><div class=\"container lesson-shell\">\n    <article class=\"lesson-box\" id=\"accordo\">\n      <h2>Die wichtigste Regel</h2>\n      <p>Das Adjektiv ändert sich mit dem Substantiv: maskulin, feminin, Singular und Plural.</p>\n      <table class=\"conj-table\"><thead><tr><th>Tipo</th><th>Singolare</th><th>Plurale</th></tr></thead><tbody><tr><td>Maschile</td><td>un libro nuovo</td><td>libri nuovi</td></tr><tr><td>Femminile</td><td>una casa nuova</td><td>case nuove</td></tr><tr><td>Aggettivi in -e</td><td>un corso interessante</td><td>corsi interessanti</td></tr></tbody></table>\n      <p class=\"mini-note\"><strong>Denken Sie daran:</strong> viele Adjektive in <strong>-e</strong> sind dem männlichen und weiblichen Singular gleich: ein interessanter Film, eine interessante Lektion.</p>\n    </article>\n\n    <article class=\"lesson-box\" id=\"posizione\">\n      <h2>Wo setzen wir das Adjektiv ein?</h2>\n      <p>Das Adjektiv steht meist hinter dem Substantiv, insbesondere wenn es eine konkrete Eigenschaft beschreibt.</p>\n      <div class=\"example-grid\"><div class=\"example\">una macchina rossa</div><div class=\"example\">un ragazzo gentile</div><div class=\"example\">una lezione utile</div><div class=\"example\">un esercizio facile</div></div>\n      <p>Einige sehr gebräuchliche Adjektive können vor dem Substantiv stehen: <strong>ein wunderschöner Tag</strong>, <strong>eine gute Idee</strong>, <strong>ein kleines Problem</strong>.</p>\n    </article>\n\n    <article class=\"lesson-box\" id=\"errori\">\n      <h2>Fehler, die fast jeder macht</h2>\n      <div class=\"mistake-grid\"><div class=\"mistake\"><strong>Errato: una casa nuovo.</strong>Corretto: una casa nuova.</div><div class=\"mistake\"><strong>Errato: libri nuova.</strong>Corretto: libri nuovi.</div><div class=\"mistake\"><strong>Errato: una lezione interessanta.</strong>Corretto: una lezione interessante.</div><div class=\"mistake\"><strong>Errato: due studenti gentile.</strong>Corretto: due studenti gentili.</div></div>\n    </article>\n\n    <article class=\"lesson-box\" id=\"esercizi\">\n      <h2>Übungen mit sofortigem Feedback</h2>\n      <p>Schreiben Sie die richtige Form des Adjektivs.</p>\n      <div class=\"exercise\" data-answer=\"nuova\" data-hint=\"Heimat ist femininer Singular: neu.\"><label>1. una casa ___ (nuovo)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"nuovi\" data-hint=\"Bücher sind männlicher Plural: neu.\"><label>2. due libri ___ (nuovo)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"interessante\" data-hint=\"Adjektive, die auf -e enden, entsprechen dem Singular.\"><label>3. una lezione ___ (interessante)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"interessanti\" data-hint=\"Im Plural werden Adjektive, die auf -e enden, zu -i.\"><label>4. due lezioni ___ (interessante)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"italiana\" data-hint=\"Ragazza ist die weibliche Einzahl: italienisch.\"><label>5. una ragazza ___ (italiano)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"italiani\" data-hint=\"Studenten sind männlicher Plural: Italiener.\"><label>6. studenti ___ (italiano)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"facile\" data-hint=\"Übung ist einzigartig: einfach.\"><label>7. un esercizio ___ (facile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"facili\" data-hint=\"Übungen sind im Plural: einfach.\"><label>8. esercizi ___ (facile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"gentile\" data-hint=\"Person ist einzigartig: freundlich.\"><label>9. una persona ___ (gentile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"exercise\" data-answer=\"gentili\" data-hint=\"Menschen ist Plural: freundlich.\"><label>10. persone ___ (gentile)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n      <div class=\"score-card\"><div><strong>Ihr Ergebnis</strong><p id=\"score-text\">0 richtige Antworten von 10</p></div><strong id=\"score-percent\">0%</strong></div>\n      <div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">Beginnen Sie erneut</button><a class=\"button primary\" href=\"../\">Zurück zur Route</a></div>\n    </article>\n  </div></section>\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>Wählen Sie, mit wem Sie Italienisch lernen</h2></div><p>Zwei Lehrkräfte, zwei Perspektiven. Wählen Sie den Ansatz, der zu Ihren Interessen passt.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Wissenschaft, Technologie und Etymologie</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Mit Martin lernen</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Kunst, Geduld und Grammatik</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Mit Licia lernen</a></article></div><div class=\"teacher-cta-links\"><a href=\"/de/ueber-uns/\">Martin und Licia kennenlernen</a><a href=\"https://wa.me/59167434075?text=Hallo%2C%20ich%20m%C3%B6chte%20Informationen%20zum%20Italienischunterricht%20mit%20Martin%20oder%20Licia.\" target=\"_blank\" rel=\"noopener\">Per WhatsApp schreiben</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Klare Grammatik, benotete Lesungen und Online-Lektionen.</p></div><div><a href=\"/de/grammatik/\">Grammatik</a><a href=\"/de/lesetexte/\">Lesungen</a><a href=\"/de/wortschatz/\">Wortschatz</a><a class=\"about-link\" href=\"/de/ueber-uns/\">Über uns</a></div></div></footer>\n<script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n\n</body></html>";
