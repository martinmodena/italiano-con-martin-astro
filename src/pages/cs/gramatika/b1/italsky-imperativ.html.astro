operty=\"og:title\" content=\"Italský imperativ | italská gramatika B1 | Italiano con Martin\"><meta property=\"og:description\" content=\"Naučte se italský imperativ pomocí příkladů a interaktivních cvičení.\"><meta property=\"og:url\" content=\"https://italianoconmartin.com/cs/gramatika/b1/italsky-imperativ.html\"><meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"Italský imperativ | italská gramatika B1 | Italiano con Martin\"><meta name=\"twitter:description\" content=\"Naučte se italský imperativ pomocí příkladů a interaktivních cvičení.\"><meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\"><link rel=\"stylesheet\" href=\"../../../styles.css\"><link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\"><link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"Italský imperativ\",\"url\":\"https://italianoconmartin.com/cs/gramatika/b1/italsky-imperativ.html\",\"inLanguage\":\"cs\"}</script></head><body data-lesson=\"martin-imperativo-b1\"><header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/cs/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇨🇿</span><span class=\"language-current\">Čeština</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/b1/imperativo.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/b1/the-italian-imperative.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/b1/el-imperativo-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/b1/limperatif-italien.html\" hreflang=\"fr\" lang=\"fr\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/b1/italsky-imperativ.html\" hreflang=\"cs\" lang=\"cs\" aria-current=\"page\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/b1/tryb-rozkazujacy-po-wlosku.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/b1/italyanca-emir-kipi.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/b1/der-italienische-imperativ.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/b1/イタリア語の命令法.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/cs/gramatika/\">Gramatika</a><a href=\"/cs/cteni/\">Čtení</a><a href=\"/cs/slovni-zasoba/\">Slovní zásoba</a><a class=\"about-link\" href=\"/cs/o-nas/\">O nás</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Rezervace na Preply</a></nav></div></header><main><section class=\"page-intro\"><div class=\"container lesson-shell\"><p class=\"breadcrumbs\"><a href=\"/cs/\">Domů</a> / <a href=\"/cs/gramatika/\">Gramatika</a> / B1 / Italský imperativ</p><p class=\"eyebrow\">Gramatika B1</p><h1>Italský imperativ</h1><p class=\"lead\">Dávejte pokyny, rady, pozvánky a pokyny přirozeným způsobem: poslouchejte, berte, odejděte, nedělejte.</p><div class=\"lesson-nav\"><a href=\"#regola\">Pravidlo</a><a href=\"#tabella\">Tabulka</a><a href=\"#esempi\">Příklady</a><a href=\"#esercizi\">Cvičení</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/cs/italsky-imperativ-b1.pdf\" download=\"\">PDF B1</a></div></div></section><section class=\"section compact-top\"><div class=\"container lesson-shell\"><article class=\"lesson-box\" id=\"regola\"><h2>Kdy se používá?</h2><p>Imperativ používáme pro pokyny, pozvánky, rady a přímé žádosti. Tón hodně závisí na situaci.</p><div class=\"example-grid\"><div class=\"example\"><strong>Istruzione</strong><br>Gira a destra.</div><div class=\"example\"><strong>Invito</strong><br>Entra, per favore.</div><div class=\"example\"><strong>Consiglio</strong><br>Dormi un po'.</div><div class=\"example\"><strong>Divieto</strong><br>Non parlare adesso.</div></div></article><article class=\"lesson-box\" id=\"tabella\"><h2>Tvaruje s vámi a vámi</h2><table class=\"conj-table\"><thead><tr><th>Infinito</th><th>Tu</th><th>Voi</th></tr></thead><tbody><tr><td>parlare</td><td>parla</td><td>parlate</td></tr><tr><td>prendere</td><td>prendi</td><td>prendete</td></tr><tr><td>partire</td><td>parti</td><td>partite</td></tr><tr><td>fare</td><td>fa' / fai</td><td>fate</td></tr><tr><td>andare</td><td>va' / vai</td><td>andate</td></tr><tr><td>dire</td><td>di'</td><td>dite</td></tr></tbody></table><p class=\"mini-note\"><strong>Negativní s vámi:</strong> ne + infinitiv. Nemluv, neber, neodcházej.</p></article><article class=\"lesson-box\" id=\"esempi\"><h2>Se zájmeny</h2><p>U kladného rozkazovacího způsobu se zájmeno připojuje na konec.</p><div class=\"example-grid\"><div class=\"example\">Prendi il libro. Prendilo.</div><div class=\"example\">Ascolta me. Ascoltami.</div><div class=\"example\">Mandate la foto. Mandatela.</div><div class=\"example\">Non lo prendere. / Non prenderlo.</div></div></article><article class=\"lesson-box\"><h2>Časté chyby</h2><div class=\"mistake-grid\"><div class=\"mistake\"><strong>Non: tu parla italiano</strong>Ma: parla italiano.</div><div class=\"mistake\"><strong>Non: non parla!</strong>Ma: non parlare!</div><div class=\"mistake\"><strong>Non: lo prendi!</strong>Ma: prendilo!</div><div class=\"mistake\"><strong>Non: andi!</strong>Ma: va'! / vai!</div></div></article><article class=\"lesson-box\" id=\"esercizi\"><h2>Cvičení s okamžitou zpětnou vazbou</h2><p>Doplňte správným imperativem.</p><div id=\"exercise-list\"><div class=\"exercise\" data-answer=\"parla\" data-hint=\"S vámi se mluvení stává mluvením.\"><label>1. ___ più lentamente, per favore. (parlare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"prendi\" data-hint=\"S vámi se braní stává braním.\"><label>2. ___ l'autobus numero 4. (prendere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"partite\" data-hint=\"S vámi se odchod stává zápasy.\"><label>3. ___ domani mattina. (voi, partire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"non parlare\" data-hint=\"Zápor s tu: ne + infinitiv.\"><label>4. ___ adesso! (tu, parlare, negativo)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"ascoltami\" data-hint=\"Zájmeno mi připojené ke slovesu.\"><label>5. ___ un momento. (ascoltare + mi)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"prendilo\" data-hint=\"Vezmi + stane se ber to.\"><label>6. Il libro è sul tavolo: ___. (prendere + lo)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"fate\" data-hint=\"S vámi se dělání stává konáním.\"><label>7. ___ attenzione! (voi, fare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"va\" data-alt=\"vai|va'\" data-hint=\"Jdi s tebou: jdi nebo jdi.\"><label>8. ___ a casa, sei stanco. (tu, andare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"dite\" data-hint=\"S tebou se říkání stává řečí.\"><label>9. ___ la verità. (voi, dire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div><div class=\"exercise\" data-answer=\"non aprire\" data-hint=\"Zápor s tu: ne + infinitiv.\"><label>10. ___ la finestra. (tu, aprire, negativo)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div></div><div class=\"score-card\"><div><strong>Váš výsledek</strong><p id=\"score-text\">0 správných odpovědí z 10</p></div><strong id=\"score-percent\">0%</strong></div><div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">Začněte znovu</button><a class=\"button primary\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Trénujte s Martinem</a></div></article></div></section><section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>Vyberte si, s kým se učit italsky</h2></div><p>Dva učitelé, dva přístupy. Vyberte si podle svých zájmů.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Věda, technologie a etymologie</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Učit se s Martinem</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Umění, trpělivost a gramatika</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Učit se s Licií</a></article></div><div class=\"teacher-cta-links\"><a href=\"/cs/o-nas/\">Poznejte Martina a Licii</a><a href=\"https://wa.me/59167434075?text=Dobr%C3%BD%20den%2C%20cht%C4%9Bl(a)%20bych%20informace%20o%20lekc%C3%ADch%20ital%C5%A1tiny%20s%20Martinem%20nebo%20Lici%C3%AD.\" target=\"_blank\" rel=\"noopener\">Napište nám na WhatsApp</a></div></div></section></main><footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Jasná gramatika, stupňovaná četba a online lekce.</p></div><div><a href=\"/cs/gramatika/\">Gramatika</a><a href=\"/cs/cteni/\">Čtení</a><a href=\"/cs/slovni-zasoba/\">Slovní zásoba</a><a class=\"about-link\" href=\"/cs/o-nas/\">O nás</a></div></div></footer><script src=\"../../../assets/grammar-exercises.js\"></script><script src=\"../../../script.js\"></script>\n</body></html>";
