const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: fr/grammaire/index.html -->\n<html lang=\"fr\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/grammatica/\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/grammar/\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/gramatica/\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/grammaire/\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/gramatika/\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/gramatyka/\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/dilbilgisi/\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/grammatik/\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/bunpo/\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/grammatica/\"><link rel=\"canonical\" href=\"https://italianoconmartin.com/fr/grammaire/\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Apprenez une règle à la fois | grammaire italienne | Italiano con Martin</title>\n  <meta name=\"description\" content=\"Cours complets de grammaire italienne du niveau A1 à C1, avec des explications simples, des tableaux, des exemples et des exercices interactifs.\">\n\n\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n  <meta name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"Apprenez une règle à la fois | grammaire italienne | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"Cours complets de grammaire italienne du niveau A1 à C1, avec des explications simples, des tableaux, des exemples et des exercices interactifs.\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/fr/grammaire/\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"Apprenez une règle à la fois | grammaire italienne | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"Cours complets de grammaire italienne du niveau A1 à C1, avec des explications simples, des tableaux, des exemples et des exercices interactifs.\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n\n  <link rel=\"stylesheet\" href=\"../../styles.css?v=20260813d\">\n  <style>\n    .level-section{margin:34px 0;scroll-margin-top:118px}.level-title{display:flex;align-items:center;gap:12px;margin-bottom:16px}.level-title h2{margin:0;font-family:Georgia,serif;font-size:2rem}.lesson-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.lesson-card{display:block;background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;text-decoration:none;box-shadow:0 10px 25px rgba(35,29,23,.05);transition:.2s}.lesson-card:hover{transform:translateY(-3px)}.lesson-card h3{margin:8px 0;font-size:1.25rem}.lesson-card p{color:var(--muted);margin:0}.lesson-card.ready{border:2px solid var(--primary)}.status{font-size:.75rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--primary)}.coming{opacity:.62}.grammar-note{background:var(--soft);border-radius:20px;padding:22px;margin-top:30px}.path-note{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:24px;padding:24px;margin-top:26px}.path-note p{color:var(--muted);margin:.25em 0 0}@media(max-width:820px){.lesson-grid,.path-note{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.lesson-grid,.path-note{grid-template-columns:1fr}.level-section{scroll-margin-top:104px}}\n  </style>\n<link rel=\"icon\" href=\"/favicon.ico?v=20260813\" sizes=\"any\"><link rel=\"icon\" href=\"/favicon.png?v=20260813\" type=\"image/png\" sizes=\"128x128\"><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png?v=20260813\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"Apprenez une règle à la fois\",\"url\":\"https://italianoconmartin.com/fr/grammaire/\",\"inLanguage\":\"fr\"}</script></head>\n<body>\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/fr/\"><img class=\"brand-avatar\" src=\"../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇫🇷</span><span class=\"language-current\">Français</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/\" hreflang=\"fr\" lang=\"fr\" aria-current=\"page\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/fr/grammaire/\">Grammaire</a><a href=\"/fr/lectures/\">Lectures</a><a href=\"/fr/vocabulaire/\">Vocabulaire</a><a class=\"about-link\" href=\"/fr/a-propos/\">À propos</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Réservez sur Preply</a></nav></div></header>\n<main>\n  <section class=\"page-intro\">\n    <div class=\"container\">\n      <p class=\"eyebrow\">grammaire italienne</p>\n      <h1>Apprenez une règle à la fois</h1>\n      <p class=\"lead\">Chaque leçon contient des explications simples, des tableaux complets, des exemples réels, des erreurs courantes et des exercices avec un feedback immédiat.</p>\n      <div class=\"level-nav\"><a href=\"#a1\">A1</a><a href=\"#a2\">A2</a><a href=\"#b1\">B1</a><a href=\"#b2\">B2</a><a href=\"#c1\">C1</a></div>\n      <div class=\"path-note\">\n        <div><strong>Vous ne savez pas par où commencer ?</strong><p>Si vous êtes débutant, suivez les leçons A1 de haut en bas. Le site enregistre vos résultats dans votre navigateur.</p></div>\n        <a class=\"button primary\" href=\"/fr/grammaire/a1/le-verbe-essere-en-italien.html\">Commencez par le verbe être</a>\n      </div>\n    </div>\n  </section>\n  <section class=\"section compact-top\">\n    <div class=\"container\">\n      <section class=\"level-section\" id=\"a1\">\n        <div class=\"level-title\"><span class=\"level\">A1</span><h2>Niveau A1</h2></div>\n        <div class=\"lesson-grid\">\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/le-verbe-essere-en-italien.html\"><span class=\"status\">Leçon interactive</span><h3>Le verbe italien essere (être)</h3><p>Conjugaison, usage, erreurs courantes et 10 exercices.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/le-verbe-avere-en-italien.html\"><span class=\"status\">Leçon interactive</span><h3>Le verbe italien avere (avoir)</h3><p>Possession, âge, sensations et expressions communes.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/articles-definis-en-italien.html\"><span class=\"status\">Leçon interactive</span><h3>Articles définis en italien</h3><p>Le, le, le, le, le, le et le expliqué clairement.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/articles-indefinis-en-italien.html\"><span class=\"status\">Leçon interactive</span><h3>Articles indéfinis en italien</h3><p>An, an, an et an' avec exemples et exercices.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/present-indicatif-des-verbes-reguliers-en-italien.html\"><span class=\"status\">Leçon interactive</span><h3>Présent de l’indicatif des verbes réguliers italiens</h3><p>Verbes en -are, -ere et -ire avec tableaux complets.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/present-des-verbes-irreguliers-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Présent des verbes irréguliers italiens</h3><p>Allez, faites, restez, donnez, venez, sortez et sachez.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/genre-et-nombre-des-noms-italiens.html\"><span class=\"status\">Leçon interactive</span><h3>Genre et nombre des noms italiens</h3><p>Masculin, féminin, singulier et pluriel.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/prepositions-simples-en-italien.html\"><span class=\"status\">Leçon interactive</span><h3>Prépositions simples en italien</h3><p>De, à, de, dans, avec, sur, pour, entre et entre.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/ce-et-ci-sono-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>C’è et ci sono en italien</h3><p>Dire qu'une personne ou une chose est présente.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/adjectifs-qualificatifs-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Adjectifs qualificatifs en italien</h3><p>Décrivez les personnes et les choses avec un accord correct.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a1/adjectifs-et-pronoms-possessifs-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Adjectifs et pronoms possessifs en italien</h3><p>Le mien, le vôtre, le sien, le nôtre, le vôtre et le leur.</p></a>\n        </div>\n      </section>\n\n      <section class=\"level-section\" id=\"a2\">\n        <div class=\"level-title\"><span class=\"level\">A2</span><h2>Niveau A2</h2></div>\n        <div class=\"lesson-grid\">\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a2/le-passato-prossimo-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Le passato prossimo italien</h3><p>Auxiliaires, participes, accord et exercices.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a2/limperfetto-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>L’imperfetto italien</h3><p>Descriptions, habitudes et actions en cours.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a2/passato-prossimo-ou-imperfetto.html\"><span class=\"status\">Nouvelle leçon</span><h3>Passato prossimo ou imperfetto</h3><p>Comparaison avec des exemples et des exercices.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a2/le-futuro-semplice-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Le futuro semplice italien</h3><p>Programmes, prévisions, promesses et irrégularités fréquentes.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a2/verbes-modaux-italiens-potere-volere-dovere.html\"><span class=\"status\">Nouvelle leçon</span><h3>Verbes modaux italiens : potere, volere et dovere</h3><p>Pouvoir, volonté et devoir avec l'infini.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/a2/pronoms-directs-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Pronoms directs en italien</h3><p>Lo, la, li, le et les pronoms au passé.</p></a>\n        </div>\n      </section>\n\n      <section class=\"level-section\" id=\"b1\">\n        <div class=\"level-title\"><span class=\"level\">B1</span><h2>Niveau B1</h2></div>\n        <div class=\"lesson-grid\">\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/b1/le-condizionale-presente-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Le condizionale presente italien</h3><p>Souhaits, conseils et demandes polies.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/b1/pronoms-combines-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Pronoms combinés en italien</h3><p>Me lo, te la, glieli et autres combinaisons.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/b1/limperatif-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>L’impératif italien</h3><p>Instructions, conseils, invitations et forme négative.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/b1/comparatif-et-superlatif-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Comparatif et superlatif en italien</h3><p>Plus, moins, comme, le plus et -issimo.</p></a>\n        </div>\n      </section>\n\n      <section class=\"level-section\" id=\"b2\">\n        <div class=\"level-title\"><span class=\"level\">B2</span><h2>Niveau B2</h2></div>\n        <div class=\"lesson-grid\">\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/b2/le-congiuntivo-presente-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Le congiuntivo presente italien</h3><p>Opinions, doutes, émotions et évaluations.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/b2/periodo-ipotetico-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Le periodo ipotetico italien</h3><p>Conditions réelles, possibles et irréelles.</p></a>\n        </div>\n      </section>\n\n      <section class=\"level-section\" id=\"c1\">\n        <div class=\"level-title\"><span class=\"level\">C1</span><h2>Niveau C1</h2></div>\n        <div class=\"lesson-grid\">\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/c1/le-congiuntivo-imperfetto-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>Le congiuntivo imperfetto italien</h3><p>Usage, concordance des temps et des nuances.</p></a>\n          <a class=\"lesson-card ready\" href=\"/fr/grammaire/c1/la-voix-passive-en-italien.html\"><span class=\"status\">Nouvelle leçon</span><h3>La voix passive en italien</h3><p>Être, venir, aller et accord de participe.</p></a>\n          <article class=\"lesson-card coming\"><h3>Discours indirect</h3><p>Transformation des temps, des pronoms et des références.</p></article>\n        </div>\n      </section>\n\n      <div class=\"grammar-note\"><strong>Comment fonctionnent les exercices ?</strong><p>Écrivez votre réponse directement dans le champ. Vous recevez immédiatement un message : corriger, continuer ou une suggestion spécifique. Le résultat reste enregistré dans la base de données locale de votre navigateur.</p></div>\n    </div>\n  </section>\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>Choisissez avec qui apprendre l’italien</h2></div><p>Deux professeurs, deux sensibilités. Choisissez l’approche qui correspond le mieux à vos intérêts.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Sciences, technologie et étymologie</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Apprendre avec Martin</a></article><article class=\"teacher-cta\"><img src=\"../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Art, patience et grammaire</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Apprendre avec Licia</a></article></div><div class=\"teacher-cta-links\"><a href=\"/fr/a-propos/\">Découvrir Martin et Licia</a><a href=\"https://wa.me/59167434075?text=Bonjour%2C%20je%20voudrais%20des%20informations%20sur%20les%20cours%20d%E2%80%99italien%20avec%20Martin%20ou%20Licia.\" target=\"_blank\" rel=\"noopener\">Écrivez-nous sur WhatsApp</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Grammaire claire, lecture notée, vocabulaire et cours en ligne.</p></div><div><a href=\"/fr/grammaire/\">Grammaire</a><a href=\"/fr/lectures/\">Lectures</a><a href=\"/fr/vocabulaire/\">Vocabulaire</a><a class=\"about-link\" href=\"/fr/a-propos/\">À propos</a></div></div></footer>\n<script src=\"../../assets/grammar-progress.js?v=20260813e\"></script><script src=\"../../script.js\"></script>\n\n\n\n\n\n</body></html>";
