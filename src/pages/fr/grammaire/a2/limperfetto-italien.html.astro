const documentHtml = "<!doctype html>\n<!-- Generated from legacy-html by scripts/import-html.mjs: fr/grammaire/a2/limperfetto-italien.html -->\n<html lang=\"fr\"><head><link rel=\"alternate\" hreflang=\"it\" href=\"https://italianoconmartin.com/grammatica/a2/imperfetto.html\"><link rel=\"alternate\" hreflang=\"en\" href=\"https://italianoconmartin.com/en/grammar/a2/the-imperfetto-tense.html\"><link rel=\"alternate\" hreflang=\"es\" href=\"https://italianoconmartin.com/es/gramatica/a2/el-imperfetto-italiano.html\"><link rel=\"alternate\" hreflang=\"fr\" href=\"https://italianoconmartin.com/fr/grammaire/a2/limperfetto-italien.html\"><link rel=\"alternate\" hreflang=\"cs\" href=\"https://italianoconmartin.com/cs/gramatika/a2/italsky-imperfetto.html\"><link rel=\"alternate\" hreflang=\"pl\" href=\"https://italianoconmartin.com/pl/gramatyka/a2/wloski-imperfetto.html\"><link rel=\"alternate\" hreflang=\"tr\" href=\"https://italianoconmartin.com/tr/dilbilgisi/a2/italyanca-imperfetto.html\"><link rel=\"alternate\" hreflang=\"de\" href=\"https://italianoconmartin.com/de/grammatik/a2/das-italienische-imperfetto.html\"><link rel=\"alternate\" hreflang=\"ja\" href=\"https://italianoconmartin.com/ja/bunpo/a2/イタリア語の-imperfetto.html\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://italianoconmartin.com/grammatica/a2/imperfetto.html\"><link rel=\"canonical\" href=\"https://italianoconmartin.com/fr/grammaire/a2/limperfetto-italien.html\">\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>L’imperfetto italien | grammaire italienne A2 | Italiano con Martin</title>\n  <meta name=\"description\" content=\"Apprenez l'imparfait italien avec les usages, les conjugaisons, les exemples du quotidien, les erreurs courantes et les exercices interactifs.\">\n\n\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large\">\n  <meta name=\"author\" content=\"Martin Modena\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:site_name\" content=\"Italiano con Martin\">\n  <meta property=\"og:title\" content=\"L’imperfetto italien | grammaire italienne A2 | Italiano con Martin\">\n  <meta property=\"og:description\" content=\"Apprenez l'imparfait italien avec les usages, les conjugaisons, les exemples du quotidien, les erreurs courantes et les exercices interactifs.\">\n  <meta property=\"og:url\" content=\"https://italianoconmartin.com/fr/grammaire/a2/limperfetto-italien.html\">\n  <meta property=\"og:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"L’imperfetto italien | grammaire italienne A2 | Italiano con Martin\">\n  <meta name=\"twitter:description\" content=\"Apprenez l'imparfait italien avec les usages, les conjugaisons, les exemples du quotidien, les erreurs courantes et les exercices interactifs.\">\n  <meta name=\"twitter:image\" content=\"https://italianoconmartin.com/assets/social-card.svg\">\n  <link rel=\"stylesheet\" href=\"../../../styles.css\">\n\n  <link rel=\"stylesheet\" href=\"../../../assets/grammar-lesson.css\">\n<link rel=\"icon\" href=\"../../../favicon.png\" type=\"image/png\"><link rel=\"apple-touch-icon\" href=\"../../../apple-touch-icon.png\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LearningResource\",\"name\":\"L’imperfetto italien\",\"url\":\"https://italianoconmartin.com/fr/grammaire/a2/limperfetto-italien.html\",\"inLanguage\":\"fr\"}</script></head>\n<body data-lesson=\"martin-imperfetto-a2\">\n<header class=\"site-header\"><div class=\"container nav-wrap\"><a class=\"brand\" href=\"/fr/\"><img class=\"brand-avatar\" src=\"../../../assets/martin-photo.svg\" alt=\"Martin\" width=\"48\" height=\"48\" decoding=\"async\"><span>Italiano con Martin</span></a><details class=\"language-switcher\"><summary aria-label=\"Language\"><span class=\"language-flag\" aria-hidden=\"true\">🇫🇷</span><span class=\"language-current\">Français</span><span class=\"language-chevron\" aria-hidden=\"true\">⌄</span></summary><div class=\"language-options\"><a href=\"/grammatica/a2/imperfetto.html\" hreflang=\"it\" lang=\"it\"><span aria-hidden=\"true\">🇮🇹</span><span>Italiano</span></a><a href=\"/en/grammar/a2/the-imperfetto-tense.html\" hreflang=\"en\" lang=\"en\"><span aria-hidden=\"true\">🇬🇧</span><span>English</span></a><a href=\"/es/gramatica/a2/el-imperfetto-italiano.html\" hreflang=\"es\" lang=\"es\"><span aria-hidden=\"true\">🇪🇸</span><span>Español</span></a><a href=\"/fr/grammaire/a2/limperfetto-italien.html\" hreflang=\"fr\" lang=\"fr\" aria-current=\"page\"><span aria-hidden=\"true\">🇫🇷</span><span>Français</span></a><a href=\"/cs/gramatika/a2/italsky-imperfetto.html\" hreflang=\"cs\" lang=\"cs\"><span aria-hidden=\"true\">🇨🇿</span><span>Čeština</span></a><a href=\"/pl/gramatyka/a2/wloski-imperfetto.html\" hreflang=\"pl\" lang=\"pl\"><span aria-hidden=\"true\">🇵🇱</span><span>Polski</span></a><a href=\"/tr/dilbilgisi/a2/italyanca-imperfetto.html\" hreflang=\"tr\" lang=\"tr\"><span aria-hidden=\"true\">🇹🇷</span><span>Türkçe</span></a><a href=\"/de/grammatik/a2/das-italienische-imperfetto.html\" hreflang=\"de\" lang=\"de\"><span aria-hidden=\"true\">🇩🇪</span><span>Deutsch</span></a><a href=\"/ja/bunpo/a2/イタリア語の-imperfetto.html\" hreflang=\"ja\" lang=\"ja\"><span aria-hidden=\"true\">🇯🇵</span><span>日本語</span></a></div></details><nav><a href=\"/fr/grammaire/\">Grammaire</a><a href=\"/fr/lectures/\">Lectures</a><a href=\"/fr/vocabulaire/\">Vocabulaire</a><a class=\"about-link\" href=\"/fr/a-propos/\">À propos</a><a class=\"nav-cta\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Réservez sur Preply</a></nav></div></header>\n<main>\n  <section class=\"page-intro\">\n    <div class=\"container lesson-shell\">\n      <p class=\"breadcrumbs\"><a href=\"/fr/\">Accueil</a> / <a href=\"/fr/grammaire/\">Grammaire</a> / A2 / L’imperfetto italien</p>\n      <p class=\"eyebrow\">Grammaire A2</p>\n      <h1>L’imperfetto italien</h1>\n      <p class=\"lead\">Apprenez à parler des habitudes du passé, des descriptions et des situations actuelles.</p>\n      <div class=\"lesson-meta\"><span>14 minutes</span><span>12 exercices</span><span>Niveau A2</span></div>\n      <div class=\"lesson-nav\"><a href=\"#uso\">Utilisation</a><a href=\"#forme\">Formes</a><a href=\"#errori\">Erreurs</a><a href=\"#esercizi\">Exercices</a></div><div class=\"pdf-downloads\" aria-label=\"PDF downloads\"><a class=\"button secondary\" href=\"/pdf/fr/limperfetto-italien-a2.pdf\" download=\"\">PDF A2</a></div>\n    </div>\n  </section>\n\n  <section class=\"section compact-top\">\n    <div class=\"container lesson-shell\">\n      <article class=\"lesson-box\" id=\"uso\">\n        <h2>Quand utilise-t-on l’imparfait ?</h2>\n        <div class=\"rule-grid\">\n          <div class=\"rule-card\"><strong>Les habitudes du passé</strong><br>Enfant, je jouais dans le jardin.</div>\n          <div class=\"rule-card\"><strong>Descriptions</strong><br>La maison était petite mais lumineuse.</div>\n          <div class=\"rule-card\"><strong>Actions en cours</strong><br>Pendant que j'étudiais, Marco m'a appelé.</div>\n          <div class=\"rule-card\"><strong>Âge, temps, temps</strong><br>J'avais dix ans. Il était huit heures. Il pleuvait.</div>\n        </div>\n        <p class=\"italian-box\"><strong>Comment parle vraiment un italien ?</strong><br>Pour raconter sa vie, l’imparfait est indispensable : <strong>Quand je vivais en Argentine, je parlais souvent italien avec ma grand-mère.</strong></p>\n      </article>\n\n      <article class=\"lesson-box\" id=\"forme\">\n        <h2>Formes régulières</h2>\n        <table class=\"conj-table\">\n          <thead><tr><th>Persona</th><th>parlare</th><th>credere</th><th>dormire</th></tr></thead>\n          <tbody>\n            <tr><td>io</td><td>parlavo</td><td>credevo</td><td>dormivo</td></tr>\n            <tr><td>tu</td><td>parlavi</td><td>credevi</td><td>dormivi</td></tr>\n            <tr><td>lui / lei</td><td>parlava</td><td>credeva</td><td>dormiva</td></tr>\n            <tr><td>noi</td><td>parlavamo</td><td>credevamo</td><td>dormivamo</td></tr>\n            <tr><td>voi</td><td>parlavate</td><td>credevate</td><td>dormivate</td></tr>\n            <tr><td>loro</td><td>parlavano</td><td>credevano</td><td>dormivano</td></tr>\n          </tbody>\n        </table>\n        <h3>Trois verbes très importants</h3>\n        <div class=\"example-grid\">\n          <div class=\"example\"><strong>essere</strong><br>ero, eri, era, eravamo, eravate, erano</div>\n          <div class=\"example\"><strong>avere</strong><br>avevo, avevi, aveva, avevamo, avevate, avevano</div>\n          <div class=\"example\"><strong>fare</strong><br>facevo, facevi, faceva, facevamo, facevate, facevano</div>\n          <div class=\"example\"><strong>dire</strong><br>dicevo, dicevi, diceva, dicevamo, dicevate, dicevano</div>\n        </div>\n      </article>\n\n      <article class=\"lesson-box\" id=\"errori\">\n        <h2>Des erreurs que presque tout le monde fait</h2>\n        <div class=\"mistake-grid\">\n          <div class=\"mistake\"><strong>Errato: io era stanco.</strong>Corretto: io ero stanco.</div>\n          <div class=\"mistake\"><strong>Errato: noi parlava.</strong>Corretto: noi parlavamo.</div>\n          <div class=\"mistake\"><strong>Errato: quando ero bambino, sono giocato.</strong>Corretto: quando ero bambino, giocavo.</div>\n          <div class=\"mistake\"><strong>Errato: facevo una pizza ieri.</strong>Meglio: ieri ho fatto una pizza.</div>\n        </div>\n      </article>\n\n      <article class=\"lesson-box\" id=\"esercizi\">\n        <h2>Exercices avec feedback immédiat</h2>\n        <p>Écrivez la forme correcte de l’imparfait.</p>\n        <div class=\"exercise\" data-answer=\"parlavo\" data-hint=\"Avec moi : je parlais.\"><label>1. Da bambino io ___ poco. (parlare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"vivevi\" data-hint=\"Avec toi : tu as vécu.\"><label>2. Tu ___ in Italia? (vivere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"era\" data-hint=\"Avec lui : c'était le cas.\"><label>3. La casa ___ grande. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"avevamo\" data-hint=\"Chez nous : nous avions.\"><label>4. Noi ___ molto tempo. (avere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"dormivate\" data-hint=\"Avec toi : tu dormais.\"><label>5. Voi ___ fino a tardi. (dormire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"andavano\" data-hint=\"Avec eux : ils sont partis.\"><label>6. Loro ___ a scuola a piedi. (andare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"facevo\" data-hint=\"Faire à l'imparfait : je l'ai fait.\"><label>7. Io ___ colazione alle otto. (fare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"diceva\" data-hint=\"Dire à l'imparfait : dit-il.\"><label>8. Marco ___ sempre la verità. (dire)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"pioveva\" data-hint=\"Pour la météo : il pleuvait.\"><label>9. Ieri mattina ___ molto. (piovere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"studiavo\" data-hint=\"Action en cours : j'étudiais.\"><label>10. Mentre ___, ha telefonato Anna. (studiare)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"erano\" data-hint=\"A huit heures : ils l'étaient.\"><label>11. ___ le otto quando sono uscito. (essere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"exercise\" data-answer=\"leggevano\" data-hint=\"Avec eux : ils lisent.\"><label>12. I bambini ___ una storia. (leggere)</label><input autocomplete=\"off\"><div class=\"feedback\"></div></div>\n        <div class=\"score-card\"><div><strong>Votre résultat</strong><p id=\"score-text\">0 bonne réponse sur 12</p></div><strong id=\"score-percent\">0%</strong></div>\n        <div class=\"exercise-actions\"><button class=\"reset-btn\" id=\"reset-exercises\" type=\"button\">Recommencer</button><a class=\"button primary\" href=\"../\">Retour à la grammaire</a></div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"conversion-section teacher-cta-section\"><div class=\"container\"><div class=\"teacher-cta-heading\"><div><p class=\"eyebrow\">Italiano con Martin</p><h2>Choisissez avec qui apprendre l’italien</h2></div><p>Deux professeurs, deux sensibilités. Choisissez l’approche qui correspond le mieux à vos intérêts.</p></div><div class=\"teacher-cta-options\"><article class=\"teacher-cta\"><img src=\"../../../assets/martin-portrait.webp\" alt=\"Martin\" width=\"800\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div><strong>Martin</strong><span>Sciences, technologie et étymologie</span></div><a class=\"button light\" href=\"https://preply.com/it/tutor/5086125\" target=\"_blank\" rel=\"noopener\">Apprendre avec Martin</a></article><article class=\"teacher-cta\"><img src=\"../../../assets/licia-portrait.webp\" alt=\"Licia\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"><div><strong>Licia</strong><span>Art, patience et grammaire</span></div><a class=\"button light\" href=\"https://preply.in/LICIA6IT2176799611?ts=17865248\" target=\"_blank\" rel=\"noopener\">Apprendre avec Licia</a></article></div><div class=\"teacher-cta-links\"><a href=\"/fr/a-propos/\">Découvrir Martin et Licia</a><a href=\"https://wa.me/59167434075?text=Bonjour%2C%20je%20voudrais%20des%20informations%20sur%20les%20cours%20d%E2%80%99italien%20avec%20Martin%20ou%20Licia.\" target=\"_blank\" rel=\"noopener\">Écrivez-nous sur WhatsApp</a></div></div></section>\n</main>\n<footer><div class=\"container footer-grid\"><div><strong>Italiano con Martin</strong><p>Grammaire claire, lectures notées et cours en ligne.</p></div><div><a href=\"/fr/grammaire/\">Grammaire</a><a href=\"/fr/lectures/\">Lectures</a><a href=\"/fr/vocabulaire/\">Vocabulaire</a><a class=\"about-link\" href=\"/fr/a-propos/\">À propos</a></div></div></footer>\n<script src=\"../../../assets/grammar-exercises.js\"></script>\n<script src=\"../../../script.js\"></script>\n\n\n\n\n</body></html>";
